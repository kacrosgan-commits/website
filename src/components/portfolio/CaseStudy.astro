---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "../cards/ProjectCard.astro";
import CtaSection from "../sections/CtaSection.astro";
import Breadcrumbs from "../ui/Breadcrumbs.astro";
import ShotGallery from "./ShotGallery.astro";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { webpCopy } from "../../utils/images";
import { isPublicProject } from "../../utils/portfolio";

interface Props {
  project: CollectionEntry<"caseStudies">;
  related: CollectionEntry<"caseStudies">[];
  reviewPeers: CollectionEntry<"caseStudies">[];
}

const { project, related, reviewPeers } = Astro.props;
const data = project.data;
const published = isPublicProject(data);
const hero = data.screenshots[0];
const heroWebp = hero ? webpCopy(hero.src) : undefined;
const gallery = data.screenshots.map((shot) => ({ ...shot, webp: webpCopy(shot.src), label: mediaLabel(shot.kind) }));
const mobile = data.mediaLayout === "mobile";
/* Unverified entries are never shown. */
const statuses = ["Confirmed platform", "Publisher-described", "Observed"] as const;
const requiredContribution = [
  ["Engagement role", data.engagementRole],
  ["Work dates", data.workDates],
  ["Features and modules implemented", data.modulesDelivered],
  ["Technologies used", data.technologiesUsed],
  ["Evidence and publication permission", data.publicationPermission],
] as const;
const optionalContribution = [
  ["Integrations developed", data.integrationsDeveloped],
  ["QA or release contribution", data.qaContribution],
] as const;
/* "Our contribution" as a short summary: the role, then when, what and how. The publication
   permission is an internal record, so it is checked above but not shown. */
const readable = (value: string) => {
  const parts = value
    .replace(/\.\s*$/, "")
    .split(";")
    .map((part) => part.trim())
    .filter(Boolean);
  if (parts.length < 2) return value.trim();
  const text = `${parts.slice(0, -1).join(", ")}, and ${parts[parts.length - 1]}`;
  return `${text.charAt(0).toUpperCase()}${text.slice(1)}.`;
};
const contributionSummary = [
  ["When", data.workDates],
  ["What we delivered", readable(data.modulesDelivered)],
  ["Built with", data.technologiesUsed],
  ["Integrations", readable(data.integrationsDeveloped)],
  ["Testing and release", readable(data.qaContribution)],
].filter(([, value]) => value.trim().length > 0);
const contributionReady =
  published && data.contributionVerified && requiredContribution.every(([, value]) => value.trim().length > 0);
const otherStack = data.technology.some((item) => item.status === "Publisher-described" || item.status === "Observed");
const verifiedMetrics = data.metrics.filter((metric) => metric.verified);

function mediaLabel(kind: string) {
  const value = kind.toLowerCase();
  if (value.includes("promotional")) return "Promotional artwork";
  if (value.includes("illustration")) return "Marketing illustration";
  return "Public page capture";
}
---

<BaseLayout
  title={data.seoTitle || data.title}
  description={data.seoDescription || data.description}
  fullTitle={Boolean(data.seoTitle)}
  noindex={!published}
  ogType="article"
  image={hero?.src}
>
  <article class="case-study pt-28 pb-8 md:pt-32" data-tone={data.tone} data-review={published ? "false" : "true"}>
    <div class="container-page">
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "Portfolio", href: "/portfolio" },
          { label: data.title },
        ]}
      />

      {
        !published && (
          <p class="review-banner mt-6">
            <span class="badge">Internal review</span>
            This page describes a public product. It is not a Vortex Digital client case study. Contribution, dates, and image permission are unconfirmed, so the production build omits this route.
          </p>
        )
      }

      <header class:list={["case-hero mt-8", mobile && "case-hero-mobile"]}>
        <div>
          <p class="case-kicker hero-in">{data.category}</p>
          <h1 class="page-title hero-in hero-in-2 mt-4">{data.title}</h1>
          {data.subtitle && <p class="mt-4 text-lg font-medium text-lavender">{data.subtitle}</p>}
          <p class="lede hero-in hero-in-3 mt-5">{data.description}</p>
          {
            data.projectUrl && (
              <p class="mt-6">
                <a class="btn btn-primary" href={data.projectUrl} target="_blank" rel="noopener noreferrer">
                  {data.projectUrlLabel}
                </a>
              </p>
            )
          }
          <p class="mt-4 text-sm text-muted">Trademarks and page designs belong to their owners. A live link is not a client endorsement.</p>
        </div>
        {
          hero && (
            <figure class="shot-stage media-settle">
              <a href={hero.src}>
                <picture>
                  {heroWebp && <source type="image/webp" srcset={heroWebp} />}
                  <img
                    src={hero.src}
                    alt={hero.alt}
                    width={hero.width}
                    height={hero.height}
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                    class:list={["case-hero-shot", mobile && "case-hero-shot-mobile"]}
                    data-vt-project={project.id}
                    style={`view-transition-name: project-${project.id}; view-transition-class: project-shot`}
                  />
                </picture>
              </a>
              <figcaption>
                <span class="badge">{mediaLabel(hero.kind)}</span>
                <span>{hero.caption}</span>
              </figcaption>
            </figure>
          )
        }
      </header>

      <section class="case-block reveal-up" aria-labelledby="overview-heading">
        <h2 id="overview-heading">Product overview</h2>
        <p>{data.overview}</p>
      </section>

      <section class="case-block reveal-up" aria-labelledby="challenge-heading">
        <h2 id="challenge-heading">{data.challengeHeading}</h2>
        <p>{data.challenge}</p>
      </section>

      <section class="case-block reveal-up" aria-labelledby="features-heading">
        <h2 id="features-heading">{data.featuresHeading}</h2>
        <ol class="feature-grid stagger-children">
          {
            data.features.map((feature) => (
              <li class="motion-item">
                <h3>{feature.title}</h3>
                <p>{feature.text}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="case-block is-wide reveal-up" aria-labelledby="gallery-heading">
        <h2 id="gallery-heading">{data.galleryHeading}</h2>
        <p class="text-muted">Select an image to view it full size.</p>
        <div class="mt-6">
          <ShotGallery shots={gallery} mobile={mobile} />
        </div>
      </section>

      <section class="case-block reveal-up" aria-labelledby="tech-heading">
        <h2 id="tech-heading">{data.technologyHeading}</h2>
        {
          (!published || otherStack) && (
            <p class="text-muted">
              {published
                ? "Confirmed entries are the stack we used. Other entries describe the public product, not our work."
                : "Public observations are separated from publisher statements. None of these notes prove which parts Vortex Digital built."}
            </p>
          )
        }
        <div class="tech-groups">
          {
            statuses.map((status) => {
              const items = data.technology.filter((item) => item.status === status);
              if (items.length === 0) return null;
              return (
                <article>
                  <h3>{status}</h3>
                  <ul>
                    {items.map((item) => (
                      <li>{item.text}</li>
                    ))}
                  </ul>
                </article>
              );
            })
          }
        </div>
      </section>

      {
        contributionReady && (
          <section class="case-block reveal-up" aria-labelledby="contribution-heading">
            <h2 id="contribution-heading">Our contribution</h2>
            <div class="contrib">
              <p class="contrib-lead">{data.engagementRole}.</p>
              <dl class="contrib-facts">
                {contributionSummary.map(([label, value]) => (
                  <div>
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </section>
        )
      }

      {
        !published && (
          <section class="case-block reveal-up" aria-labelledby="contribution-heading">
            <h2 id="contribution-heading">Our contribution</h2>
            <p>
              {site.name} has not confirmed a role on this product. The fields below are blank on purpose. They are not filled with a guessed scope, stack, or date.
            </p>
            <dl class="contribution-list">
              {[...requiredContribution, ...optionalContribution].map(([label]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>Not confirmed</dd>
                </div>
              ))}
            </dl>
            {data.contributionPrompt && <p class="mt-4 text-sm text-muted">{data.contributionPrompt}</p>}
          </section>
        )
      }

      {
        verifiedMetrics.length > 0 && (
          <section class="case-block reveal-up" aria-labelledby="outcomes-heading">
            <h2 id="outcomes-heading">Outcomes</h2>
            <dl class="feature-grid">
              {verifiedMetrics.map((metric) => (
                <div>
                  <dt>{metric.label}</dt>
                  <dd class="font-display text-3xl font-semibold">{metric.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        related.length > 0 && (
          <section class="case-block is-wide reveal-up" aria-labelledby="related-heading">
            <h2 id="related-heading">Related projects</h2>
            <div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
              {related.map((entry) => (
                <ProjectCard project={entry} />
              ))}
            </div>
          </section>
        )
      }

      {
        reviewPeers.length > 0 && (
          <section class="case-block is-wide reveal-up" aria-labelledby="review-peers-heading">
            <h2 id="review-peers-heading">Also in this review</h2>
            <p class="text-muted">Other unapproved products in the local review. They are not published client work.</p>
            <div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
              {reviewPeers.map((entry) => (
                <ProjectCard project={entry} />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>
  <CtaSection
    title={data.ctaTitle || "Have a Similar Product in Mind?"}
    description={
      data.ctaDescription ||
      "Tell us what you want to build, and we'll talk through the best approach."
    }
    href="/contact"
    label={data.ctaLabel || "Discuss Your Project"}
  />
</BaseLayout>

