---
/**
 * Case-study gallery. Website captures show as 16:10 previews in a browser frame, cropped from the
 * top of the screenshot; app artwork shows whole, with no extra phone frame. Each preview is a
 * link to the full file, so without JavaScript it simply opens the image. With JavaScript it opens
 * the native <dialog> viewer below: arrow keys move between images, Escape and the close button
 * close it, and focus returns to the preview of the image last shown.
 */
interface Shot {
  src: string;
  webp?: string;
  alt: string;
  caption: string;
  width: number;
  height: number;
  label?: string;
}

interface Props {
  shots: Shot[];
  mobile: boolean;
}

const { shots, mobile } = Astro.props;
---

<div class:list={["shot-gallery stagger-children", mobile ? "shot-gallery-mobile" : "shot-gallery-web"]} data-shot-gallery>
  {
    shots.map((shot, index) => (
      <figure class="motion-item">
        <a
          class="shot-open"
          href={shot.src}
          data-shot
          data-index={index}
          data-full={shot.webp ?? shot.src}
          data-alt={shot.alt}
          data-caption={shot.caption}
          data-width={shot.width}
          data-height={shot.height}
        >
          {!mobile && (
            <span class="browser-bar" aria-hidden="true">
              <span class="browser-dots">
                <i></i>
                <i></i>
                <i></i>
              </span>
            </span>
          )}
          <span class="shot-crop">
            <picture>
              {shot.webp && <source type="image/webp" srcset={shot.webp} />}
              <img src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" />
            </picture>
          </span>
          <span class="shot-open-label">View full size</span>
        </a>
        <figcaption>
          {shot.label && <span class="badge">{shot.label}</span>}
          <span>{shot.caption}</span>
        </figcaption>
      </figure>
    ))
  }
</div>

<dialog class="viewer" data-shot-dialog aria-label="Image viewer">
  <div class="viewer-bar">
    <p class="viewer-count" data-shot-count aria-live="polite"></p>
    <button type="button" class="viewer-btn viewer-close" data-shot-close>
      Close<span class="sr-only"> image viewer</span>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>
  <figure class="viewer-figure">
    <div class="viewer-stage" data-shot-stage></div>
    <figcaption data-shot-caption></figcaption>
  </figure>
  {
    shots.length > 1 && (
      <div class="viewer-nav">
        <button type="button" class="viewer-btn" data-shot-prev>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M15 5l-7 7 7 7" />
          </svg>
          Previous<span class="sr-only"> image</span>
        </button>
        <button type="button" class="viewer-btn" data-shot-next>
          Next<span class="sr-only"> image</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    )
  }
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-shot-dialog]");
  const triggers = [...document.querySelectorAll<HTMLAnchorElement>("[data-shot]")];

  if (dialog && triggers.length > 0 && typeof dialog.showModal === "function") {
    const stage = dialog.querySelector<HTMLElement>("[data-shot-stage]")!;
    const caption = dialog.querySelector<HTMLElement>("[data-shot-caption]")!;
    const count = dialog.querySelector<HTMLElement>("[data-shot-count]")!;
    const closeButton = dialog.querySelector<HTMLButtonElement>("[data-shot-close]")!;
    // Created here rather than in markup, so the closed viewer never requests an image.
    const full = document.createElement("img");
    full.decoding = "async";
    stage.append(full);
    let current = 0;

    const show = (index: number) => {
      current = (index + triggers.length) % triggers.length;
      const link = triggers[current]!;
      full.width = Number(link.dataset.width) || 0;
      full.height = Number(link.dataset.height) || 0;
      full.src = link.dataset.full ?? link.href;
      full.alt = link.dataset.alt ?? "";
      caption.textContent = link.dataset.caption ?? "";
      count.textContent = triggers.length > 1 ? `Image ${current + 1} of ${triggers.length}` : "";
    };

    triggers.forEach((link, index) => {
      link.addEventListener("click", (event) => {
        // Let new-tab and download clicks through.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
        event.preventDefault();
        show(index);
        dialog.showModal();
        closeButton.focus();
      });
    });

    dialog.querySelector("[data-shot-prev]")?.addEventListener("click", () => show(current - 1));
    dialog.querySelector("[data-shot-next]")?.addEventListener("click", () => show(current + 1));
    closeButton.addEventListener("click", () => dialog.close());

    // A click on the dimmed backdrop (the dialog element itself, outside its content) closes it.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        show(current + 1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        show(current - 1);
      } else if (event.key === "Tab") {
        // Keep focus inside the viewer.
        const focusable = [...dialog.querySelectorAll<HTMLElement>("button")];
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      }
    });

    // Escape closes the dialog natively. Either way, focus returns to the preview last shown.
    dialog.addEventListener("close", () => {
      triggers[current]?.focus();
    });
  }
</script>
