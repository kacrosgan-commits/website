---
/**
 * CMS-release case study renderer.
 * Used only when CONTENT_SOURCE=cms. Local mode continues to use CaseStudy.astro
 * with Astro content collections (contribution fields remain code/MDX-owned).
 */
import HeroStage from "../visuals/HeroStage.astro";
import CtaSection from "../sections/CtaSection.astro";
import Breadcrumbs from "../ui/Breadcrumbs.astro";
import ShotGallery from "./ShotGallery.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { NormalizedProject } from "../../lib/content/types";

interface Props {
  project: NormalizedProject;
  related: NormalizedProject[];
}

const { project, related } = Astro.props;
const hero = project.screenshots[0];
const mobile = project.mediaLayout === "mobile";
const gallery = project.screenshots
  .slice(1)
  .flatMap((shot) => (shot.src ? [{ ...shot, src: shot.src }] : []))
  .map((shot) => ({
    src: shot.src,
    alt: shot.alt,
    caption: shot.caption || "",
    width: shot.width || (mobile ? 600 : 1440),
    height: shot.height || (mobile ? 1299 : 900),
  }));
---

<BaseLayout
  title={`${project.title} — Case Study`}
  description={project.description}
  image={hero?.src || "/og.png"}
>
  <article class="relative isolate pt-28 pb-16 md:pt-32">
    <HeroStage scene="study" plates={hero?.src ? [hero.src] : []} band quiet />
    <div class="container-page relative z-[1]">
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "Portfolio", href: "/portfolio" },
          { label: project.title },
        ]}
      />
      <header class="mt-10 max-w-3xl">
        <p class="eyebrow hero-in">{project.client} · {project.industry}</p>
        <h1 class="page-title hero-in hero-in-2 mt-4">{project.title}</h1>
        <p class="lede hero-in hero-in-3 mt-6">{project.description}</p>
        {
          project.projectUrl ? (
            <p class="mt-4">
              <a class="lux-link" href={project.projectUrl} rel="noopener noreferrer">
                {project.projectUrlLabel || "View project"}
              </a>
            </p>
          ) : null
        }
      </header>

      {
        hero?.src ? (
          <figure class={`media-settle mt-12 overflow-hidden rounded-xl ${mobile ? "max-w-sm mx-auto" : ""}`}>
            <img
              src={hero.src}
              alt={hero.alt}
              width={hero.width || 1440}
              height={hero.height || 900}
              class="w-full h-auto"
              loading="eager"
              decoding="async"
            />
            {hero.caption ? <figcaption class="mt-3 text-sm text-muted">{hero.caption}</figcaption> : null}
          </figure>
        ) : null
      }

      <section class="case-block reveal-up" aria-labelledby="services-heading">
        <h2 id="services-heading">Services</h2>
        <ul class="tag-list">
          {project.services.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <section class="case-block reveal-up" aria-labelledby="technologies-heading">
        <h2 id="technologies-heading">Technologies</h2>
        <ul class="tag-list">
          {project.technologies.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      {
        gallery.length > 0 ? (
          <section class="case-block is-wide reveal-up" aria-labelledby="gallery-heading">
            <h2 id="gallery-heading">Screenshots</h2>
            <p class="text-muted">Select an image to view it full size.</p>
            <div class="mt-6">
              <ShotGallery shots={gallery} mobile={mobile} />
            </div>
          </section>
        ) : null
      }

      {
        related.length ? (
          <section class="case-block is-wide reveal-up" aria-labelledby="related-heading">
            <h2 id="related-heading">More work</h2>
            <div class="stagger-children mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {related.slice(0, 3).map((item) => (
                <a href={`/portfolio/${item.slug}/`} class="related-card motion-item">
                  <span class="related-card-client">{item.client}</span>
                  <span class="related-card-title">{item.cardTitle || item.title}</span>
                  <span class="related-card-text">{item.cardSummary || item.description}</span>
                </a>
              ))}
            </div>
          </section>
        ) : null
      }
    </div>
  </article>
  <CtaSection
    title="Building something similar?"
    description="Share the product, what already exists, and what the next release has to do."
    href="/contact"
    label="Start a conversation"
  />
</BaseLayout>
