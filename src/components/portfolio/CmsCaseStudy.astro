---
/**
 * CMS-release case study renderer.
 * Used only when CONTENT_SOURCE=cms. Local mode continues to use CaseStudy.astro
 * with Astro content collections (contribution fields remain code/MDX-owned).
 */
import CtaSection from "../sections/CtaSection.astro";
import Breadcrumbs from "../ui/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { NormalizedProject } from "../../lib/content/types";

interface Props {
  project: NormalizedProject;
  related: NormalizedProject[];
}

const { project, related } = Astro.props;
const hero = project.screenshots[0];
const mobile = project.mediaLayout === "mobile";
---

<BaseLayout
  title={`${project.title} — Case Study`}
  description={project.description}
  image={hero?.src || "/og.png"}
>
  <article class="pt-28 pb-16 md:pt-32">
    <div class="container-page">
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "Portfolio", href: "/portfolio" },
          { label: project.title },
        ]}
      />
      <header class="mt-10 max-w-3xl">
        <p class="eyebrow">{project.client} · {project.industry}</p>
        <h1 class="page-title mt-4">{project.title}</h1>
        <p class="lede mt-6">{project.description}</p>
        {
          project.projectUrl ? (
            <p class="mt-4">
              <a class="text-lavender hover:text-paper" href={project.projectUrl} rel="noopener noreferrer">
                {project.projectUrlLabel || "View project"}
              </a>
            </p>
          ) : null
        }
      </header>

      {
        hero?.src ? (
          <figure class={`mt-12 overflow-hidden rounded-xl ${mobile ? "max-w-sm mx-auto" : ""}`}>
            <img
              src={hero.src}
              alt={hero.alt}
              width={hero.width || 1440}
              height={hero.height || 900}
              class="w-full h-auto"
              loading="eager"
              decoding="async"
            />
            {hero.caption ? <figcaption class="mt-3 text-sm text-muted">{hero.caption}</figcaption> : null}
          </figure>
        ) : null
      }

      <section class="mt-14 grid gap-8 md:grid-cols-2">
        <div>
          <h2 class="section-title text-2xl">Services</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {project.services.map((item) => (
              <li class="tech-chip">{item}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="section-title text-2xl">Technologies</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {project.technologies.map((item) => (
              <li class="tech-chip">{item}</li>
            ))}
          </ul>
        </div>
      </section>

      {
        project.screenshots.length > 1 ? (
          <section class="mt-16" aria-labelledby="gallery-heading">
            <h2 id="gallery-heading" class="section-title text-2xl">
              Screenshots
            </h2>
            <div class={`mt-8 grid gap-6 ${mobile ? "md:grid-cols-3 max-w-4xl" : "md:grid-cols-2"}`}>
              {project.screenshots.slice(1).map((shot) =>
                shot.src ? (
                  <figure>
                    <img
                      src={shot.src}
                      alt={shot.alt}
                      width={shot.width || 1200}
                      height={shot.height || 800}
                      class="w-full h-auto rounded-lg"
                      loading="lazy"
                      decoding="async"
                    />
                    {shot.caption ? <figcaption class="mt-2 text-sm text-muted">{shot.caption}</figcaption> : null}
                  </figure>
                ) : null,
              )}
            </div>
          </section>
        ) : null
      }

      {
        related.length ? (
          <section class="mt-20" aria-labelledby="related-heading">
            <h2 id="related-heading" class="section-title text-2xl">
              More work
            </h2>
            <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {related.slice(0, 3).map((item) => (
                <a href={`/portfolio/${item.slug}/`} class="block rounded-xl border border-white/10 p-5 hover:border-lavender/40">
                  <p class="text-sm text-muted">{item.client}</p>
                  <h3 class="mt-2 text-lg text-paper">{item.cardTitle || item.title}</h3>
                  <p class="mt-2 text-sm text-muted">{item.cardSummary || item.description}</p>
                </a>
              ))}
            </div>
          </section>
        ) : null
      }
    </div>
  </article>
  <CtaSection
    title="Building something similar?"
    description="Share the product, what already exists, and what the next release has to do."
    href="/contact"
    label="Start a conversation"
  />
</BaseLayout>
