---
import { technologyGroups } from "../../data/technologies";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section class="section reveal home-tech" aria-labelledby="stack-heading">
  <div class="container-page">
    <SectionHeading eyebrow="Stack" description="A working catalog aligned with the roles on the team. It is not a certification list.">
      <span id="stack-heading">Technology That Fits Your Product.</span>
    </SectionHeading>
    <div class="home-tech-groups stagger-children mt-10">
      {
        technologyGroups.map((group) => (
          <div class="home-tech-group motion-item">
            <h3 class="text-sm font-semibold tracking-[0.14em] text-lavender uppercase">{group.label}</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="home-tech-pill">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
