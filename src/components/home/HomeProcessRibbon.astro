---
import type { ProcessStep } from "../../data/process";
import Icon from "../ui/Icon.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  steps: ProcessStep[];
}

const { steps } = Astro.props;
---

<section class="section reveal home-process" aria-labelledby="process-heading">
  <div class="container-page">
    <SectionHeading eyebrow="Process" description="Six engineering stages. Scope and timing are agreed in a proposal, not assumed from this page.">
      <span id="process-heading">From Concept to Launch.</span>
    </SectionHeading>

    <ol class="home-process-track section-divider-motion stagger-children mt-12">
      {
        steps.map((step, index) => (
          <li class="home-process-step motion-item">
            <p class="home-process-index">{String(index + 1).padStart(2, "0")}</p>
            <h3 class="mt-3 font-display text-xl font-semibold tracking-[-0.03em]">{step.homeTitle ?? step.title}</h3>
            <p class="mt-2 text-sm text-muted">{step.summary}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-8">
      <a href="/process" class="inline-flex items-center gap-2 font-semibold text-lavender">
        See the full process
        <Icon name="arrow-right" size={16} class="arrow" />
      </a>
    </div>
  </div>
</section>
