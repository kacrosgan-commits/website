const { slug, title } = Astro.props;
const diagram = diagrams[slug];
if (!diagram) {
  throw new Error(`Missing service diagram: ${slug}`);
}

const byId = new Map(diagram.nodes.map((node) => [node.id, node]));

function edgePath(fromId: string, toId: string): string {
  const from = byId.get(fromId);
  const to = byId.get(toId);
  if (!from || !to) return "";
  const y1 = from.y + from.h / 2;
  const y2 = to.y + to.h / 2;
  const x1 = from.x + from.w;
  const x2 = to.x;
  if (x2 > x1 + 12) {
    const mid = x1 + Math.min(28, (x2 - x1) / 2);
    if (Math.abs(y1 - y2) < 20) return `M ${x1} ${y1} H ${x2}`;
    return `M ${x1} ${y1} H ${mid} V ${y2} H ${x2}`;
  }
  const xMid = from.x + from.w / 2;
  const startY = y2 > y1 ? from.y + from.h : from.y;
  const endY = y2 > y1 ? to.y : to.y + to.h;
  return `M ${xMid} ${startY} V ${(startY + endY) / 2} H ${to.x + to.w / 2} V ${endY}`;
}
---

<figure class="service-diagram">
  <svg viewBox="0 0 640 440" role="img" aria-label={`${title}. ${diagram.label}`}>
    <rect width="640" height="440" rx="24" fill="#120e22"></rect>
    <g fill="none" stroke="#C084FC" stroke-width="1.5" opacity="0.85">
      {
        diagram.edges.map(([from, to]) => (
          <path d={edgePath(from, to)} marker-end={`url(#arrow-${slug})`} />
        ))
      }
    </g>
    {
      diagram.nodes.map((node) => (
        <g>
          <rect x={node.x} y={node.y} width={node.w} height={node.h} rx="16" fill="#1C1533" stroke="rgba(192,132,252,0.45)" />
          <text x={node.x + 16} y={node.y + 36} fill="#F8F7FF" font-size="15" font-family="Space Grotesk, Inter, sans-serif">
            {node.label}
          </text>
          <text x={node.x + 16} y={node.y + 60} fill="#A7A0BD" font-size="12" font-family="Inter, sans-serif">
            {node.detail}
          </text>
        </g>
      ))
    }
    <defs>
      <marker id={`arrow-${slug}`} markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
        <path d="M0 0 L6 3 L0 6" fill="#C084FC"></path>
      </marker>
    </defs>
  </svg>
  <figcaption>{diagram.caption}</figcaption>
</figure>
