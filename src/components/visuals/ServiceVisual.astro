---
interface Node {
  id: string;
  x: number;
  y: number;
  w: number;
  h: number;
  label: string;
  detail: string;
}

interface Diagram {
  label: string;
  caption: string;
  nodes: Node[];
  edges: [string, string][];
}

interface Props {
  slug: string;
  title: string;
}

