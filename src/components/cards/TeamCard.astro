---
import { publicName, type TeamMember } from "../../data/team";

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const name = publicName(member);
const badge = member.isPublished
  ? ""
  : member.portrait.identityVerified
    ? ""
    : member.portrait.source === "supplied"
      ? "Supplied photo"
      : "Illustrative portrait";
const skills = member.expertise.map((item) => item.title);
---

<article class="surface-card team-card flex h-full flex-col overflow-hidden">
  <div class="relative block overflow-hidden">
    <img
      src={member.portrait.src}
      alt={member.portrait.alt}
      width={member.portrait.width}
      height={member.portrait.height}
      class="team-photo"
      loading="lazy"
      decoding="async"
    />
    {badge && <span class="badge absolute top-3 left-3">{badge}</span>}
  </div>
  <div class="flex flex-1 flex-col p-6">
    {
      name ? (
        <>
          <h3 class="font-display text-2xl font-semibold tracking-[-0.03em]">
            <a href={`/team/${member.slug}`} class="hover:text-lavender">{name}</a>
          </h3>
          <p class="mt-1 text-sm text-lavender">{member.role}</p>
        </>
      ) : (
        <h3 class="font-display text-2xl font-semibold tracking-[-0.03em]">
          <a href={`/team/${member.slug}`} class="hover:text-lavender">{member.role}</a>
        </h3>
      )
    }
    <p class="mt-3 text-muted">{member.intro}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        skills.map((skill) => (
          <li class="rounded-full border border-line px-2.5 py-1 text-xs text-lavender">{skill}</li>
        ))
      }
    </ul>
    <a href={`/team/${member.slug}`} class="mt-auto inline-flex h-11 items-center pt-6 font-semibold text-lavender">View Profile</a>
    {
      (member.linkedin || member.github || member.portfolio) && (
        <div class="team-social mt-5 flex gap-2">
          {member.linkedin && (
            <a
              href={member.linkedin}
              class="inline-flex h-11 w-11 items-center justify-center rounded-[10px] border border-line text-lavender hover:border-lilac"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${name ?? member.role} on LinkedIn`}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M4.7 3.6h3.1v3.1H4.7V3.6zM4.7 9h3.1v11.4H4.7V9zm5.4 0h3v1.6h.1c.4-.8 1.5-1.7 3.1-1.7 3.3 0 3.9 2.2 3.9 5v6.5h-3.1v-5.8c0-1.4 0-3.1-1.9-3.1s-2.2 1.5-2.2 3v5.9H10.1V9z" />
              </svg>
            </a>
          )}
          {member.github && (
            <a
              href={member.github}
              class="inline-flex h-11 w-11 items-center justify-center rounded-[10px] border border-line text-lavender hover:border-lilac"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${name ?? member.role} on GitHub`}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.1-1.47-1.1-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8a9.6 9.6 0 0 1 2.5.34c1.9-1.29 2.74-1.02 2.74-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.95.36.31.68.92.68 1.86v2.76c0 .26.18.58.69.48A10 10 0 0 0 12 2z" />
              </svg>
            </a>
          )}
        </div>
      )
    }
  </div>
</article>
