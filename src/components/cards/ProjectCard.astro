---
import type { CollectionEntry } from "astro:content";
import { portfolioArt } from "../../data/assets";
import { formatDate } from "../../utils/format";
import { cardCopy } from "../../utils/images";
import { isPublicProject } from "../../utils/portfolio";
import MediaFrame from "../ui/MediaFrame.astro";

interface Props {
  project: CollectionEntry<"caseStudies">;
}

const { project } = Astro.props;
const shot = project.data.screenshots[0];
const shotCard = shot ? cardCopy(shot.src) : undefined;
const art = shot ? undefined : portfolioArt(project.id);
const published = isPublicProject(project.data);
const mobile = project.data.mediaLayout === "mobile";
---

<article
  class="portfolio-card reveal-plate motion-item"
  data-category={project.data.category}
  data-filters={project.data.filters.join("|")}
>
  {
    shot && (
      <div class="shot-stage" data-tilt>
        <span class="shot-shadow" aria-hidden="true" />
        <a href={`/portfolio/${project.id}`} class:list={["shot-frame", mobile ? "shot-frame-mobile" : "shot-frame-web"]}>
          <picture>
            {shotCard && <source type="image/webp" srcset={shotCard} />}
            <img
              src={shot.src}
              alt={shot.alt}
              width={shot.width}
              height={shot.height}
              loading="lazy"
              decoding="async"
            />
          </picture>
        </a>
      </div>
    )
  }
  {
    art && (
      <MediaFrame
        src={art}
        alt={`Demonstration illustration for ${project.data.title}. Not a client result.`}
        width={1200}
        height={760}
        fit="contain"
        class="aspect-[1200/760] rounded-none border-0"
      />
    )
  }
  <div class="project-body">
    <div class="project-meta">
      <span>{project.data.category}</span>
      {
        published ? (
          <time datetime={project.data.date.toISOString()}>{formatDate(project.data.date)}</time>
        ) : (
          <span>Contribution not confirmed</span>
        )
      }
    </div>
    {
      (project.data.sample || (!published && project.data.review)) && (
        <div class="mt-2 flex flex-wrap gap-2">
          {project.data.sample && <span class="badge">Sample project</span>}
          {!published && project.data.review && <span class="badge">Internal review</span>}
        </div>
      )
    }
    <h3 class="project-title">
      <a href={`/portfolio/${project.id}`}>{project.data.cardTitle || project.data.title}</a>
    </h3>
    <p class="project-summary">{project.data.cardSummary || project.data.description}</p>
    {
      project.data.publicPlatform.length > 0 && (
        <p class="project-stack">Public platform: {project.data.publicPlatform.join(", ")}</p>
      )
    }
    {project.data.sample && project.data.technologies.length > 0 && (
      <p class="mt-2 text-xs text-muted">Illustrative stack for this sample. Not a delivered project.</p>
    )}
    <div class="project-foot">
      <span>{(published || project.data.sample) && project.data.technologies.join(", ")}</span>
      <a href={`/portfolio/${project.id}`} class="lux-link">View Case Study</a>
    </div>
  </div>
</article>
