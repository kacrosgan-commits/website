---
import type { ProcessStep } from "../../data/process";

interface Props {
  steps: ProcessStep[];
  compact?: boolean;
}

const { steps, compact = false } = Astro.props;
---

{
  compact ? (
    <ol class="process-track" data-process-progress>
      {steps.map((step, index) => (
        <li class="process-step">
          <p class="process-num">{index + 1}</p>
          <h3 class="process-title">{step.homeTitle ?? step.title}</h3>
          <p class="process-text">{step.summary}</p>
        </li>
      ))}
    </ol>
  ) : (
    <ol class="stage-list stagger-children">
      {steps.map((step) => (
        <li id={step.id} class="stage-row motion-item">
          <p class="stage-num" aria-hidden="true">{step.number}</p>
          <div class="stage-head">
            <h2 class="stage-title">{step.title}</h2>
            <p class="stage-summary">{step.summary}</p>
          </div>
          <ul class="stage-details">
            {step.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  )
}
