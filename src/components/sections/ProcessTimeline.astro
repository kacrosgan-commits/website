---
import type { ProcessStep } from "../../data/process";

interface Props {
  steps: ProcessStep[];
  compact?: boolean;
}

const { steps, compact = false } = Astro.props;
---

{
  compact ? (
    <ol class="process-row grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {steps.map((step, index) => (
        <li class="surface-card relative p-6">
          <p class="font-display text-sm font-semibold tracking-[0.14em] text-lilac">{String(index + 1).padStart(2, "0")}</p>
          <h3 class="mt-3 font-display text-2xl font-semibold tracking-[-0.03em]">{step.homeTitle ?? step.title}</h3>
          <p class="mt-3 text-muted">{step.summary}</p>
        </li>
      ))}
    </ol>
  ) : (
    <ol class="timeline">
      {steps.map((step) => (
        <li class="timeline-step">
          <span class="timeline-index">{step.number}</span>
          <article class="surface-card p-6 md:p-8">
            <h2 class="font-display text-2xl font-semibold tracking-[-0.03em] md:text-3xl">{step.title}</h2>
            <p class="mt-3 text-lg text-muted">{step.summary}</p>
            <ul class="mt-5 grid gap-2 text-paper/90">
              {step.details.map((detail) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-lilac" aria-hidden="true" />
                  <span>{detail}</span>
                </li>
              ))}
            </ul>
          </article>
        </li>
      ))}
    </ol>
  )
}
