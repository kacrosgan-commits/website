---
import type { FaqItem } from "../../data/faq";

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item) => (
      <details class="faq-item">
        <summary>
          <span>{item.question}</span>
          <span class="faq-mark" aria-hidden="true" />
        </summary>
        <div class="faq-panel">
          <p>{item.answer}</p>
        </div>
      </details>
    ))
  }
</div>
