---
import GradientButton from "../ui/GradientButton.astro";
import OutlineButton from "../ui/OutlineButton.astro";

interface Props {
  title?: string;
  description?: string;
  href?: string;
  label?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  /** The thin gold circle with its orbiting bead behind the headline. */
  ring?: boolean;
}

const {
  title = "Have an Idea? Let's Build It.",
  description = "Tell us what you're working on. We'll help you explore the right technical approach for your next product.",
  href = "/contact",
  label = "Discuss Your Project",
  secondaryHref = "",
  secondaryLabel = "",
  ring = true,
} = Astro.props;
---

<section class="lux-cta reveal-fade">
  <img class="cta-art" src="/images/vortex-digital-hall.webp" alt="" width="1813" height="868" loading="lazy" decoding="async" />
  {
    ring && (
      <svg class="cta-ring" viewBox="0 0 200 200" aria-hidden="true">
        <circle class="cta-ring-line" cx="100" cy="100" r="99" pathLength="1"></circle>
        <g class="cta-ring-orbit"><circle class="cta-ring-bead" cx="100" cy="1" r="0.9"></circle></g>
      </svg>
    )
  }
  <div class="container-page lux-cta-inner">
    <h2 class="section-title lux-cta-title">{title}</h2>
    <p class="lux-cta-text">{description}</p>
    <div class="lux-cta-actions">
      <GradientButton href={href}>{label}</GradientButton>
      {secondaryHref && secondaryLabel && <OutlineButton href={secondaryHref}>{secondaryLabel}</OutlineButton>}
    </div>
  </div>
</section>
