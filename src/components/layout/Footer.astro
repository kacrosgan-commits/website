---
import { activeSocialLinks, footerNavigation, site } from "../../data/site";
import Logo from "../ui/Logo.astro";
import SocialLinks from "../ui/SocialLinks.astro";

const footerLinks = footerNavigation;
/* The email shows only once PUBLIC_CONTACT_EMAIL is a real inbox (same check as the contact page). */
const showEmail = !site.emailIsPlaceholder;
const hasContact = showEmail || Boolean(site.location);
---

<footer class="site-footer reveal-fade">
  <div class="container-page footer-grid">
    <div class="footer-brand min-w-0">
      <a href="/" aria-label={`${site.name} home`} class="inline-flex rounded-lg">
        <Logo />
      </a>
      <p class="footer-summary">{site.summary}</p>
      {activeSocialLinks.length > 0 && <SocialLinks class="mt-6" />}
    </div>
    <nav class="min-w-0" aria-labelledby="footer-explore">
      <h2 id="footer-explore" class="footer-heading">Explore</h2>
      <ul class="footer-links">
        {
          footerLinks.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      hasContact && (
        <div class="min-w-0">
          <h2 class="footer-heading">Contact</h2>
          <ul class="footer-links">
            {showEmail && (
              <li>
                <a href={`mailto:${site.email}`} class="footer-email">
                  {site.email}
                </a>
              </li>
            )}
            {site.location && (
              <li>
                <span>{site.location}</span>
              </li>
            )}
          </ul>
        </div>
      )
    }
  </div>
  <p class="footer-wordmark" aria-hidden="true">{site.name}</p>
  <div class="footer-base">
    <div class="container-page footer-base-row">
      <p>© {site.copyrightYear} {site.legalName || site.name}. All rights reserved.</p>
      <span class="flex flex-wrap gap-x-5">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms</a>
      </span>
    </div>
    {
      site.nameIsPlaceholder && (
        <p class="container-page pb-8 text-sm text-muted">
          {site.name} is a working name in the site configuration. Replace the name, domain, email, and team profiles before launch.
        </p>
      )
    }
  </div>
</footer>
