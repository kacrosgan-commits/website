---
interface Props {
  eyebrow?: string;
  description?: string;
  align?: "left" | "center";
}

const { eyebrow, description, align = "left" } = Astro.props;
---

<div class:list={[align === "center" && "mx-auto text-center", "max-w-3xl"]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class:list={["section-title", eyebrow && "mt-4"]}>
    <slot />
  </h2>
  {
    description && (
      <p class:list={["lede mt-5 max-w-2xl", align === "center" && "mx-auto"]}>{description}</p>
    )
  }
</div>
