---
import { site } from "../../data/site";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<span class:list={["logo-lockup", className]}>
  <img class="logo-mark" src="/images/logo-mark.webp" alt="" width="160" height="160" decoding="async" />
  <span class="logo-word">{site.name}</span>
</span>
