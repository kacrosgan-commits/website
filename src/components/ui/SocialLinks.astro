---
import { activeSocialLinks, type SocialLink } from "../../data/site";

interface Props {
  links?: SocialLink[];
  class?: string;
}

const { links = activeSocialLinks, class: className = "" } = Astro.props;
---

{
  links.length > 0 && (
    <ul class:list={["flex flex-wrap gap-2", className]}>
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="inline-flex h-11 w-11 items-center justify-center rounded-[10px] border border-line text-lavender transition hover:border-lilac hover:bg-violet/15"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.label}
          >
            {link.icon === "linkedin" && (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M4.7 3.6h3.1v3.1H4.7V3.6zM4.7 9h3.1v11.4H4.7V9zm5.4 0h3v1.6h.1c.4-.8 1.5-1.7 3.1-1.7 3.3 0 3.9 2.2 3.9 5v6.5h-3.1v-5.8c0-1.4 0-3.1-1.9-3.1s-2.2 1.5-2.2 3v5.9H10.1V9z" />
              </svg>
            )}
            {link.icon === "instagram" && (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <rect x="4" y="4" width="16" height="16" rx="4" />
                <circle cx="12" cy="12" r="3.2" />
                <circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none" />
              </svg>
            )}
            {link.icon === "youtube" && (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M21 8.2a3 3 0 0 0-2.1-2.1C17.2 5.7 12 5.7 12 5.7s-5.2 0-6.9.4A3 3 0 0 0 3 8.2 31 31 0 0 0 2.6 12 31 31 0 0 0 3 15.8a3 3 0 0 0 2.1 2.1c1.7.4 6.9.4 6.9.4s5.2 0 6.9-.4a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .4-3.8 31 31 0 0 0-.4-3.8zM10.4 15.1V8.9L15.5 12l-5.1 3.1z" />
              </svg>
            )}
            {link.icon === "x" && (
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M14.7 10.3 21.4 3h-1.6l-5.8 6.4L9.3 3H3.4l7 9.9L3.4 21h1.6l6.2-6.8L14.7 21h5.9l-7.3-10.7zm-2.2 2.4-.7-1-5.7-7.9h2.4l4.6 6.4.7 1 6 8.3h-2.4l-4.9-6.8z" />
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  )
}
