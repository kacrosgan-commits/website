---
import Breadcrumbs from "./Breadcrumbs.astro";
import HeroStage from "../visuals/HeroStage.astro";
import type { HeroScene } from "../../data/hero-scenes";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  eyebrow: string;
  description: string;
  crumbs?: Crumb[];
  visual?: HeroScene;
  labels?: string[];
  plates?: string[];
  /** When false, the hero stays on the CSS scene and does not load WebGL. */
  live?: boolean;
}

const { eyebrow, description, crumbs = [], visual = "editorial", labels, plates, live = true } = Astro.props;
---

<section class="relative isolate overflow-hidden pt-28 pb-16 md:pt-36 md:pb-20">
  <HeroStage scene={visual} labels={labels} plates={plates} engine={live ? "webgl" : "css"} />
  <div class="container-page relative z-[1]">
    {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
    <p class="eyebrow hero-in">{eyebrow}</p>
    <h1 class="page-title hero-in hero-in-2 mt-5 max-w-3xl">
      <slot />
    </h1>
    <p class="lede hero-in hero-in-3 mt-6 max-w-2xl">{description}</p>
    <div class="hero-in hero-in-4 mt-8">
      <slot name="actions" />
    </div>
  </div>
</section>
