---
import Breadcrumbs from "./Breadcrumbs.astro";
import HeroTitle from "./HeroTitle.astro";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  eyebrow: string;
  description: string;
  /** Plain-text title. Without it, the default slot supplies the h1 content. */
  title?: string;
  /** Always written as BreadcrumbList structured data. */
  crumbs?: Crumb[];
  /** Also show the breadcrumb trail on the page. */
  showCrumbs?: boolean;
  /**
   * compact: a short heading so the page's content starts in the first view.
   * split: title beside a supporting element in the `aside` slot.
   */
  layout?: "compact" | "split";
}

const { eyebrow, description, title, crumbs = [], showCrumbs = false, layout = "compact" } = Astro.props;
const hasAside = Astro.slots.has("aside");
const hasActions = Astro.slots.has("actions");
---

<section class:list={["inner-hero", `inner-hero-${layout}`]} data-hero>
  <div class="container-page">
    {crumbs.length > 0 && <Breadcrumbs items={crumbs} visible={showCrumbs} />}
    <div class:list={["inner-hero-grid", hasAside && "has-aside"]}>
      <div class="inner-hero-copy">
        <div class="inner-hero-head">
          <p class="eyebrow hero-in">{eyebrow}</p>
          {
            title ? (
              <HeroTitle text={title} />
            ) : (
              <h1 class="page-title inner-title hero-in hero-in-2">
                <slot />
              </h1>
            )
          }
        </div>
        <div class="inner-hero-foot">
          <p class="lede hero-in hero-in-3">{description}</p>
          {
            hasActions && (
              <div class="inner-hero-actions hero-in hero-in-4">
                <slot name="actions" />
              </div>
            )
          }
        </div>
      </div>
      {
        hasAside && (
          <div class="inner-hero-aside hero-in hero-in-3">
            <slot name="aside" />
          </div>
        )
      }
    </div>
  </div>
</section>
