---
import { adjacentMembers, getMember, publicName, type TeamMember } from "../../data/team";
import { getTeamForRender, getTeamMemberForRender, isCmsRenderMode } from "../../lib/content/site-content";
import { personTransitionName } from "../../utils/transitions";

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const name = publicName(member);
const cms = isCmsRenderMode();
const { previous, next } = cms
  ? (() => {
      const roster = getTeamForRender();
      const index = roster.findIndex((item) => item.slug === member.slug);
      return {
        previous: roster[(index - 1 + roster.length) % roster.length],
        next: roster[(index + 1) % roster.length],
      };
    })()
  : adjacentMembers(member.slug);
/* Unpublished profiles keep a short, honest label for the kind of portrait they show. */
const portraitNote = member.isPublished
  ? ""
  : member.portrait.source === "supplied"
    ? "Portrait supplied for this role."
    : "Illustrative portrait.";
const links = [
  member.linkedin ? { href: member.linkedin, label: "LinkedIn" } : null,
  member.github ? { href: member.github, label: "GitHub" } : null,
  member.portfolio ? { href: member.portfolio, label: "Portfolio" } : null,
].filter((link) => link !== null);
const related = member.related
  .map((item) => ({ item, person: cms ? getTeamMemberForRender(item.slug) : getMember(item.slug) }))
  .filter((entry): entry is { item: (typeof member.related)[number]; person: TeamMember } => Boolean(entry.person));
const label = (person: TeamMember) => publicName(person) ?? person.role;
---

<article class="profile">
  <div class="container-page">
    <p class="profile-back">
      <a href="/team" class="lux-link">Back to Team</a>
    </p>
    <header class="profile-hero">
      <figure class="profile-portrait-frame">
        <img
          src={member.portrait.src}
          alt={member.portrait.alt}
          width={member.portrait.width}
          height={member.portrait.height}
          class="profile-portrait"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          sizes="(min-width: 64rem) 40vw, 100vw"
          data-vt-person={member.slug}
          style={`view-transition-name: ${personTransitionName(member.slug)}; view-transition-class: person`}
        />
        {portraitNote && <figcaption class="profile-portrait-note">{portraitNote}</figcaption>}
      </figure>
      <div class="profile-intro">
        {!member.isPublished && <p class="badge">Role profile</p>}
        <p class="eyebrow hero-in">{name ? member.role : "Role"}</p>
        <h1 class="page-title profile-name hero-in hero-in-2">{name ?? member.role}</h1>
        <p class="lede profile-lede hero-in hero-in-3">{member.intro}</p>
        {member.experience && <p class="profile-experience hero-in hero-in-3">{member.experience}</p>}
        {!member.isPublished && <p class="profile-note">This page describes the role.</p>}
        {
          links.length > 0 && (
            <p class="profile-links">
              {links.map((link) => (
                <a href={link.href} class="lux-link" target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ))}
            </p>
          )
        }
      </div>
    </header>
  </div>

  <section class="section profile-section reveal-up" aria-labelledby="overview-heading">
    <div class="container-page split">
      <h2 id="overview-heading" class="split-title is-small">{member.isPublished ? "Background" : "Role overview"}</h2>
      <div class="copy">
        {member.biography.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  {
    member.externalExperience && member.externalExperience.length > 0 && (
      <section class="section profile-section reveal-up" aria-labelledby="external-heading">
        <div class="container-page split">
          <h2 id="external-heading" class="split-title is-small">Previous and external experience</h2>
          <div class="copy">
            {member.externalExperience.map((paragraph) => <p>{paragraph}</p>)}
            <p class="profile-aside">Earlier roles and studies, separate from Vortex Digital.</p>
          </div>
        </div>
      </section>
    )
  }

  <section class="section profile-section reveal-up" aria-labelledby="role-heading">
    <div class="container-page split">
      <h2 id="role-heading" class="split-title is-small">Responsibilities and expertise</h2>
      <div class="profile-columns">
        <div>
          <h3 class="profile-subhead">{member.isPublished ? "Current responsibilities" : "Areas of responsibility"}</h3>
          <ul class="line-list">
            {
              member.responsibilities.map((item) => (
                <li>
                  <span class="line-list-title">{item.title}</span>
                  <span class="line-list-text">{item.detail}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="profile-subhead">Expertise</h3>
          <ul class="line-list">
            {
              member.expertise.map((item) => (
                <li>
                  <span class="line-list-title">{item.title}</span>
                  <span class="line-list-text">{item.detail}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  {
    member.startupSupport && (
      <section class="section profile-section reveal-up" aria-labelledby="startup-heading">
        <div class="container-page split">
          <h2 id="startup-heading" class="split-title is-small">How this role supports startups</h2>
          <div class="copy">
            <p>{member.startupSupport}</p>
          </div>
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section profile-section reveal-up" aria-labelledby="related-heading">
        <div class="container-page split">
          <div>
            <h2 id="related-heading" class="split-title is-small">Related disciplines</h2>
            <p class="profile-aside mt-4">The people this role works with most closely.</p>
          </div>
          <ul class="related-list">
            {related.map(({ item, person }) => (
              <li>
                <a href={`/team/${person.slug}`} class="related-link">
                  <img src={person.portrait.thumb} alt="" width="384" height="384" loading="lazy" decoding="async" />
                  <span class="related-copy">
                    <span class="related-name">{label(person)}</span>
                    {publicName(person) && <span class="related-role">{person.role}</span>}
                    <span class="related-note">{item.note}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    member.projectIds.length > 0 && (
      <section class="section profile-section reveal-up" aria-labelledby="projects-heading">
        <div class="container-page split">
          <h2 id="projects-heading" class="split-title is-small">Project contributions</h2>
          <ul class="line-list">
            {member.projectIds.map((id) => (
              <li>
                <a class="lux-link" href={`/portfolio/${id}`}>
                  {id}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <nav class="section profile-section profile-pager-section" aria-label="Other team members">
    <div class="container-page">
      <h2 class="sr-only">More of the team</h2>
      <div class="profile-pager">
        <a href={`/team/${previous.slug}`} class="pager-link">
          <img src={previous.portrait.thumb} alt="" width="384" height="384" loading="lazy" decoding="async" />
          <span class="pager-copy">
            <span class="pager-dir">Previous</span>
            <span class="pager-name">{label(previous)}</span>
            {publicName(previous) && <span class="pager-role">{previous.role}</span>}
          </span>
        </a>
        <a href={`/team/${next.slug}`} class="pager-link pager-next">
          <img src={next.portrait.thumb} alt="" width="384" height="384" loading="lazy" decoding="async" />
          <span class="pager-copy">
            <span class="pager-dir">Next</span>
            <span class="pager-name">{label(next)}</span>
            {publicName(next) && <span class="pager-role">{next.role}</span>}
          </span>
        </a>
      </div>
      <p class="profile-back profile-back-end">
        <a href="/team" class="lux-link">Back to Team</a>
      </p>
    </div>
  </nav>
</article>
