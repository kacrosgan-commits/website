---
import { adjacentMembers, getMember, publicName, type TeamMember } from "../../data/team";
import OutlineButton from "../ui/OutlineButton.astro";

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const name = publicName(member);
const { previous, next } = adjacentMembers(member.slug);
const badge = member.isPublished
  ? ""
  : member.portrait.source === "supplied"
    ? "Supplied photo · identity not confirmed"
    : "Illustrative portrait";
const links = [
  member.linkedin ? { href: member.linkedin, label: "LinkedIn" } : null,
  member.github ? { href: member.github, label: "GitHub" } : null,
  member.portfolio ? { href: member.portfolio, label: "Portfolio" } : null,
].filter((link) => link !== null);
---

<article class="pt-28 pb-8 md:pt-32">
  <div class="container-page">
    <p class="text-sm">
      <a href="/team" class="text-lavender hover:text-paper">Back to Team</a>
    </p>
    <div class="profile-hero mt-8">
      <figure class="profile-portrait-frame">
        <img
          src={member.portrait.src}
          alt={member.portrait.alt}
          width={member.portrait.width}
          height={member.portrait.height}
          class="profile-portrait"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          sizes="(min-width: 1024px) 520px, 100vw"
        />
        {badge && <span class="badge absolute top-4 left-4">{badge}</span>}
      </figure>
      <div>
        {!member.isPublished && <p class="badge">Internal review · role profile</p>}
        <p class="eyebrow mt-6">{name ? member.role : "Role"}</p>
        <h1 class="page-title mt-4">{name ?? member.role}</h1>
        <p class="lede mt-5">{member.intro}</p>
        {member.experience && <p class="mt-4 text-sm font-medium text-lavender">{member.experience}</p>}
        {
          member.isPublished ? (
            <p class="mt-6 text-sm text-muted">
              This biography was supplied by the agency owner for publication. It is not an independently verified résumé, and it does not assign a client case study to this person.
            </p>
          ) : (
            <p class="mt-6 text-sm text-muted">
              This page describes the role. It is not a personal biography.
              {member.portrait.source === "supplied"
                ? " The portrait was supplied for this seat and has not been confirmed as a named employee."
                : " The portrait is illustrative and is not a photograph of a verified employee."}
            </p>
          )
        }
      </div>
    </div>
  </div>

  <section class="section" aria-labelledby="overview-heading">
    <div class="container-page grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 id="overview-heading" class="section-title text-[clamp(2rem,3vw,2.8rem)]">{member.isPublished ? "Background" : "Role overview"}</h2>
      </div>
      <div class="grid gap-4 lg:col-span-8">
        {member.biography.map((paragraph) => <p class="text-lg text-paper/90">{paragraph}</p>)}
      </div>
    </div>
  </section>

  {
    member.externalExperience && member.externalExperience.length > 0 && (
      <section class="section bg-ink-soft/40" aria-labelledby="external-heading">
        <div class="container-page grid gap-8 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <h2 id="external-heading" class="section-title text-[clamp(2rem,3vw,2.8rem)]">Previous and external experience</h2>
          </div>
          <div class="grid gap-4 lg:col-span-8">
            {member.externalExperience.map((paragraph) => <p class="text-lg text-paper/90">{paragraph}</p>)}
            <p class="text-sm text-muted">These employers and studies are separate from Vortex Digital. They are not agency projects.</p>
          </div>
        </div>
      </section>
    )
  }

  <section class="section bg-ink-soft/40" aria-labelledby="responsibility-heading">
    <div class="container-page">
      <h2 id="responsibility-heading" class="section-title">{member.isPublished ? "Current responsibilities" : "Areas of responsibility"}</h2>
      {
        !member.isPublished && (
          <p class="mt-4 max-w-2xl text-muted">These are the duties of the seat. They are not a record of work already performed by a named person.</p>
        )
      }
      <ol class="responsibility-grid mt-10">
        {
          member.responsibilities.map((item, index) => (
            <li>
              <span>0{index + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="expertise-heading">
    <div class="container-page">
      <h2 id="expertise-heading" class="section-title">Expertise</h2>
      <p class="mt-4 max-w-2xl text-muted">
        {
          member.isPublished
            ? "Owner-confirmed expertise. Certifications, awards, and client-project credits are not listed."
            : "Role capabilities. Personal skills, certifications, and years of experience are not listed until they are confirmed."
        }
      </p>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {
          member.expertise.map((item) => (
            <article class="surface-card p-6">
              <h3 class="font-display text-2xl font-semibold tracking-[-0.03em]">{item.title}</h3>
              <p class="mt-3 text-muted">{item.detail}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="working-heading">
    <div class="container-page">
      <h2 id="working-heading" class="section-title">Working Together</h2>
      <p class="mt-4 max-w-2xl text-muted">
        Both scenes are generated illustrations of collaborative software work around this role. They are not photographs of Vortex Digital employees or documented meetings.
      </p>
      <div class="collab-gallery mt-10">
        {
          member.workImages.map((image, index) => (
            <figure class:list={[index === 0 ? "collab-primary" : "collab-secondary"]}>
              <img
                src={image.src}
                alt={image.alt}
                width={image.width}
                height={image.height}
                class="work-photo"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="mt-3 text-sm text-muted">{image.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-ink-soft/40" aria-labelledby="startup-heading">
    <div class="container-page grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 id="startup-heading" class="section-title text-[clamp(2rem,3vw,2.8rem)]">How this role supports startups</h2>
      </div>
      <p class="text-lg text-paper/90 lg:col-span-8">{member.startupSupport}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="related-heading">
    <div class="container-page">
      <h2 id="related-heading" class="section-title">Related disciplines</h2>
      <p class="mt-4 max-w-2xl text-muted">How this seat connects to the other eight roles. These are working relationships, not accounts of specific meetings.</p>
      <ul class="mt-10 grid gap-4 md:grid-cols-3">
        {
          member.related.map((item) => {
            const person = getMember(item.slug);
            if (!person) return null;
            return (
              <li>
                <a href={`/team/${person.slug}`} class="surface-card block h-full p-6 hover:text-lavender">
                  <span class="text-sm text-lilac">Works with</span>
                  <span class="mt-2 block font-display text-2xl font-semibold text-paper">{publicName(person) ?? person.role}</span>
                  {publicName(person) && <span class="mt-1 block text-sm text-lavender">{person.role}</span>}
                  <span class="mt-3 block text-muted">{item.note}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  {
    member.projectIds.length > 0 && (
      <section class="section" aria-labelledby="projects-heading">
        <div class="container-page">
          <h2 id="projects-heading" class="section-title">Project contributions</h2>
          <ul class="mt-6 grid gap-3">
            {member.projectIds.map((id) => (
              <li>
                <a class="font-semibold text-lavender" href={`/portfolio/${id}`}>{id}</a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    links.length > 0 && (
      <section class="section" aria-labelledby="connect-heading">
        <div class="container-page">
          <h2 id="connect-heading" class="font-display text-3xl font-semibold">Professional links</h2>
          <div class="mt-6 flex flex-wrap gap-3">
            {links.map((link) => (
              <OutlineButton href={link.href}>{link.label}</OutlineButton>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <nav class="section pt-0" aria-label="Other team members">
    <div class="container-page">
      <h2 class="font-display text-3xl font-semibold">More of the team</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <a href={`/team/${previous.slug}`} class="surface-card team-nav flex flex-wrap items-center gap-4 p-4">
          <img
            src={previous.portrait.thumb}
            alt=""
            width="384"
            height="384"
            class="h-16 w-16 flex-none rounded-2xl object-cover"
            loading="lazy"
            decoding="async"
          />
          <span class="min-w-0 flex-[1_1_8rem]">
            <span class="block text-sm text-muted">Previous</span>
            <span class="mt-1 block font-display text-xl font-semibold">{publicName(previous) ?? previous.role}</span>
            {publicName(previous) && <span class="mt-1 block text-sm text-lavender">{previous.role}</span>}
          </span>
        </a>
        <a href={`/team/${next.slug}`} class="surface-card team-nav flex flex-wrap items-center gap-4 p-4 md:flex-row-reverse md:text-right">
          <img
            src={next.portrait.thumb}
            alt=""
            width="384"
            height="384"
            class="h-16 w-16 flex-none rounded-2xl object-cover"
            loading="lazy"
            decoding="async"
          />
          <span class="min-w-0 flex-[1_1_8rem]">
            <span class="block text-sm text-muted">Next</span>
            <span class="mt-1 block font-display text-xl font-semibold">{publicName(next) ?? next.role}</span>
            {publicName(next) && <span class="mt-1 block text-sm text-lavender">{next.role}</span>}
          </span>
        </a>
      </div>
      <p class="mt-8">
        <a href="/team" class="font-semibold text-lavender">Back to Team</a>
      </p>
    </div>
  </nav>
</article>
