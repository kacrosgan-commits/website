---
import "../styles/global.css";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import { site } from "../data/site";
import { absoluteUrl, jsonLd } from "../utils/format";
import { ensureContentMode, getContentSource } from "../lib/content";

// Default remains local. cms-shadow is audited via scripts (no draft leak into HTML).
// cms mode fails closed here until owner-approved baseline exists.
const contentSource = getContentSource();
if (contentSource === "cms") {
  await ensureContentMode();
}

interface Props {
  title: string;
  description: string;
  fullTitle?: boolean;
  noindex?: boolean;
  /** Set to false on pages served for other URLs, such as the 404 page. */
  hasCanonical?: boolean;
  ogType?: "website" | "article";
  image?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  fullTitle = false,
  noindex = false,
  hasCanonical = true,
  ogType = "website",
  image = "/og.png",
  schema,
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} · ${site.name}`;
const canonical = absoluteUrl(Astro.url.pathname, site.url);
const imageUrl = absoluteUrl(image, site.url);
const organization = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  description: site.description,
  url: site.url,
  ...(site.emailIsPlaceholder ? {} : { email: site.email }),
  areaServed: "Worldwide",
};
const graph = [organization, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {hasCanonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {hasCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#090713" />
    <link rel="preload" href="/fonts/antic-didone-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={jsonLd(graph.length === 1 ? graph[0] : graph)} />
  </head>
  <body>
    <div class="page-glow" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var selector = ".reveal, .reveal-up, .reveal-fade, .reveal-scale, .reveal-plate, .stagger-children";
        var reveal = function (node) {
          node.classList.add("is-in");
          node.classList.remove("await-reveal");
        };
        var revealChain = function (node) {
          var current = node;
          while (current && current !== document.body) {
            if (current.matches && current.matches(selector)) reveal(current);
            current = current.parentElement;
          }
        };
        if (!("IntersectionObserver" in window)) return;
        var observer;
        try {
          observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              reveal(entry.target);
              observer.unobserve(entry.target);
            });
          }, { threshold: 0, rootMargin: "0px 0px 12% 0px" });
        } catch (error) {
          return;
        }
        var arm = function (node) {
          if (node.classList.contains("is-in")) return;
          var rect = node.getBoundingClientRect();
          if (rect.height < 1) return;
          if (rect.bottom > 0 && rect.top < window.innerHeight) reveal(node);
          else {
            node.classList.add("await-reveal");
            observer.observe(node);
          }
        };
        var exposeHash = function () {
          if (!location.hash) return;
          var id = "";
          try { id = decodeURIComponent(location.hash.slice(1)); } catch (error) { return; }
          var target = document.getElementById(id);
          if (target) revealChain(target);
        };
        document.querySelectorAll(selector).forEach(arm);
        exposeHash();
        document.documentElement.classList.add("can-reveal");
        var scan = function () {
          document.querySelectorAll(selector).forEach(function (node) {
            if (!node.classList.contains("await-reveal") || node.classList.contains("is-in")) return;
            var rect = node.getBoundingClientRect();
            if (rect.height < 1) return;
            if (rect.bottom > 0 && rect.top < window.innerHeight) {
              reveal(node);
              observer.unobserve(node);
            }
          });
        };
        document.addEventListener("focusin", function (event) {
          if (event.target && event.target.closest) revealChain(event.target);
        });
        window.addEventListener("scroll", scan, { passive: true });
        window.addEventListener("hashchange", exposeHash);
        window.addEventListener("pageshow", function (event) {
          if (!event.persisted) return;
          document.querySelectorAll(selector).forEach(function (node) {
            var rect = node.getBoundingClientRect();
            if (rect.bottom > 0 && rect.top < window.innerHeight) reveal(node);
          });
        });
      })();
    </script>
    <script>
      import "../scripts/luxe-motion.ts";
    </script>
  </body>
</html>
