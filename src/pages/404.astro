---
import GradientButton from "../components/ui/GradientButton.astro";
import OutlineButton from "../components/ui/OutlineButton.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description={`That page is not part of the ${site.name} website.`} noindex hasCanonical={false}>
  <section class="relative overflow-hidden pt-32 pb-24 md:pt-40">
    <div class="ambient" aria-hidden="true">
      <div class="orb orb-a"></div>
      <div class="orb orb-b"></div>
    </div>
    <div class="container-page relative max-w-3xl">
      <p class="eyebrow">404</p>
      <h1 class="page-title mt-5">This page is not on the map.</h1>
      <p class="lede mt-6">The link may be out of date, or the page has not been published. You can return home or tell us what you were looking for.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <GradientButton href="/">Back to home</GradientButton>
        <OutlineButton href="/contact">Contact the team</OutlineButton>
      </div>
    </div>
  </section>
</BaseLayout>
