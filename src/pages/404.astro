---
import GradientButton from "../components/ui/GradientButton.astro";
import OutlineButton from "../components/ui/OutlineButton.astro";
import PageHero from "../components/ui/PageHero.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description={`That page is not part of the ${site.name} website.`} noindex hasCanonical={false}>
  <PageHero
    eyebrow="404"
    title="This page is not on the map."
    description="The link may be out of date, or the page has not been published. You can return home or tell us what you were looking for."
  >
    <div slot="actions" class="flex flex-wrap gap-3">
      <GradientButton href="/">Back to home</GradientButton>
      <OutlineButton href="/contact">Contact the team</OutlineButton>
    </div>
  </PageHero>
</BaseLayout>
