---
import CtaSection from "../components/sections/CtaSection.astro";
import ProcessTimeline from "../components/sections/ProcessTimeline.astro";
import PageHero from "../components/ui/PageHero.astro";
import { processSteps } from "../data/process";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getContentSource } from "../lib/content/source";
import { getPageSectionsForRender } from "../lib/content/site-content";

const cms = getContentSource() === "cms";
/* Only a CMS hero section supplies the hero. The seeded "steps" section is the stage list, not a title. */
const cmsHero = cms ? getPageSectionsForRender("process").find((section) => section.section_key === "hero") : undefined;
const heroEyebrow = cmsHero?.eyebrow || "Our process";
const heroTitle = cmsHero?.title || "From Concept to Launch";
const heroDescription = cmsHero?.body || "Six stages, with scope and timing agreed with you before work begins.";
---

<BaseLayout
  title="Our Process"
  description={`How ${site.name} moves from discovery to deployment: requirements, architecture, design, development, testing, and support.`}
>
  <PageHero
    eyebrow={heroEyebrow}
    title={heroTitle}
    description={heroDescription}
    crumbs={[{ label: "Home", href: "/" }, { label: "Our Process" }]}
    layout="split"
  >
    <nav slot="aside" class="stage-index" aria-label="Process stages">
      <ol>
        {
          processSteps.map((step) => (
            <li>
              <a href={`#${step.id}`}>
                <span class="stage-index-num" aria-hidden="true">
                  {step.number}
                </span>
                <span class="stage-index-name">{step.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </PageHero>
  <section class="section inner-next" aria-labelledby="stages-heading">
    <div class="container-page">
      <h2 id="stages-heading" class="sr-only">Engagement stages</h2>
      <ProcessTimeline steps={processSteps} />
    </div>
  </section>
  <CtaSection title="Start with discovery." description="Tell us what you are building. We will suggest where the engineering process should begin." />
</BaseLayout>
