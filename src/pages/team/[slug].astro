---
import TeamProfile from "../../components/team/TeamProfile.astro";
import { publicName } from "../../data/team";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getContentSource } from "../../lib/content/source";
import { getTeamForRender } from "../../lib/content/site-content";

export function getStaticPaths() {
  const members = getTeamForRender();
  return members.map((member) => ({ params: { slug: member.slug }, props: { member } }));
}

const { member } = Astro.props;
const name = publicName(member);
const cms = getContentSource() === "cms";
---

<BaseLayout
  title={name ? `${name} — ${member.role}` : member.role}
  description={name ? `${name}, ${member.role} at ${site.name}. ${member.intro}` : `${member.role} at ${site.name}. ${member.intro}`}
  noindex={!member.isPublished}
  image={member.portrait.src}
>
  {cms ? <p class="sr-only">CMS release profile</p> : null}
  <TeamProfile member={member} />
</BaseLayout>
