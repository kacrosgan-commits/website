---
import CtaSection from "../components/sections/CtaSection.astro";
import Icon from "../components/ui/Icon.astro";
import PageHero from "../components/ui/PageHero.astro";
import { about, buildServices } from "../data/about";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getContentSource } from "../lib/content/source";
import { getPageSectionsForRender, getTeamForRender } from "../lib/content/site-content";

const cms = getContentSource() === "cms";
const team = getTeamForRender();
const cmsAboutSections = cms ? getPageSectionsForRender("about") : [];

if (!cms && team.length !== 9) {
  throw new Error(`Expected 9 team roles, found ${team.length}`);
}
if (!cms && buildServices.length !== 8) {
  throw new Error(`Expected 8 services, found ${buildServices.length}`);
}

---

<BaseLayout
  title={`About ${site.name} | Software Development for Startups`}
  description={`Meet ${site.name}, a software development agency focused on web applications, mobile apps, AI solutions, SaaS platforms, and engineering services for startups.`}
  fullTitle
>
  <PageHero
    eyebrow={about.heroEyebrow}
    title={about.heroTitle}
    description={about.heroDescription}
    crumbs={[{ label: "Home", href: "/" }, { label: "About Us" }]}
    layout="split"
  >
    <p slot="actions" class="inner-hero-note">{site.tagline}</p>
    <figure slot="aside" class="photo-frame about-photo">
      <img
        src="/images/vortex-hall-reception.webp"
        alt="Vortex Digital reception desk under a ring light, with the company name on the wall behind it"
        width="663"
        height="829"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </PageHero>

  {
    cmsAboutSections.length > 0 ? (
      <section class="section inner-next">
        <div class="container-page cms-sections" data-cms-about-sections>
          {cmsAboutSections.map((section) => (
            <div class="split">
              <div>
                {section.eyebrow ? <p class="eyebrow">{section.eyebrow}</p> : null}
                {section.title ? <h2 class="split-title mt-3">{section.title}</h2> : null}
              </div>
              {section.body ? (
                <div class="copy">
                  <p>{section.body}</p>
                </div>
              ) : null}
            </div>
          ))}
        </div>
      </section>
    ) : null
  }

  <section class="section inner-next reveal" aria-labelledby="who-heading">
    <div class="container-page split">
      <h2 id="who-heading" class="split-title">{about.whoHeading}</h2>
      <div class="copy">
        {about.who.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section reveal" aria-labelledby="audience-heading">
    <div class="container-page split">
      <div>
        <h2 id="audience-heading" class="split-title">{about.audienceHeading}</h2>
        <p class="split-note">{about.audienceNote}</p>
      </div>
      <ol class="line-list is-numbered">
        {
          about.audiences.map((item, index) => (
            <li>
              <span class="line-list-num" aria-hidden="true">0{index + 1}</span>
              <span class="line-list-title is-display">{item.title}</span>
              <span class="line-list-text">{item.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section reveal" aria-labelledby="mission-heading">
    <div class="container-page mv-grid">
      <article>
        <p class="eyebrow">Mission</p>
        <h2 id="mission-heading" class="mv-title">{about.missionHeading}</h2>
        <p class="mv-statement">{about.mission}</p>
        <p class="mv-support">{about.missionSupport}</p>
      </article>
      <article>
        <p class="eyebrow">Vision</p>
        <h2 class="mv-title">{about.visionHeading}</h2>
        <p class="mv-statement">{about.vision}</p>
        <p class="mv-support">{about.visionSupport}</p>
      </article>
    </div>
  </section>

  <section class="section reveal" aria-labelledby="philosophy-heading">
    <div class="container-page">
      <h2 id="philosophy-heading" class="section-title max-w-4xl">{about.philosophyHeading}</h2>
      <ul class="open-grid cols-3 mt-[clamp(2rem,4vw,3.5rem)]">
        {
          about.philosophy.map((item) => (
            <li>
              <Icon name={item.icon} class="open-grid-icon" />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section reveal" aria-labelledby="more-heading">
    <div class="container-page">
      <h2 id="more-heading" class="sr-only">More about the company</h2>
      <ul class="link-rows">
        <li class="link-row">
          <p class="link-row-label">Specialties</p>
          <div class="link-row-body">
            <h3 class="link-row-title">{about.buildHeading}</h3>
            <p class="link-row-text">{buildServices.map(({ label }) => label).join(" · ")}</p>
          </div>
          <a href="/portfolio" class="lux-link link-row-link">See our work</a>
        </li>
        <li class="link-row">
          <p class="link-row-label">Process</p>
          <div class="link-row-body">
            <h3 class="link-row-title">{about.processHeading}</h3>
            <p class="link-row-text">{about.processSummary}</p>
          </div>
          <a href="/process" class="lux-link link-row-link">See the full process</a>
        </li>
        <li class="link-row">
          <p class="link-row-label">Team</p>
          <div class="link-row-body">
            <h3 class="link-row-title">{about.teamHeading}</h3>
            <a href="/team" class="team-strip" tabindex="-1" aria-hidden="true">
              {
                team.map((member) => (
                  <img src={member.portrait.thumb} alt="" width="384" height="384" loading="lazy" decoding="async" />
                ))
              }
            </a>
          </div>
          <a href="/team" class="lux-link link-row-link">Meet the team</a>
        </li>
      </ul>
    </div>
  </section>

  <CtaSection
    title={about.ctaTitle}
    description={about.ctaDescription}
    href="/contact"
    label="Discuss Your Project"
    secondaryHref="/process"
    secondaryLabel="See Our Process"
  />
</BaseLayout>
