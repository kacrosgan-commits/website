---
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, readingTime } from "../../utils/format";
import { isPublicInsight, relatedPublicInsights } from "../../utils/insights";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const dev = import.meta.env.DEV;
  const visible = posts.filter((post) => isPublicInsight(post.data) || (dev && post.data.editorialReview));
  return visible.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const published = isPublicInsight(post.data);
const minutes = readingTime(post.body ?? "");
const contents = headings.filter((heading) => heading.depth === 2);
const showContents = contents.length >= 4;
const entries = await getCollection("blog");
const related = relatedPublicInsights(
  entries.map((entry) => ({ ...entry.data, id: entry.id })),
  post.id,
  post.data.category,
).map((item) => entries.find((entry) => entry.id === item.id)!);
const publishedAt = post.data.publishedAt ?? null;
const schema = published
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      ...(publishedAt ? { datePublished: publishedAt.toISOString() } : {}),
      ...(post.data.updatedAt ? { dateModified: post.data.updatedAt.toISOString() } : {}),
      author: { "@type": "Organization", name: site.name },
      publisher: { "@type": "Organization", name: site.name, url: site.url },
      mainEntityOfPage: new URL(`/insights/${post.id}`, site.url).href,
    }
  : undefined;
---

<BaseLayout
  title={`${post.data.title} — Insights`}
  description={post.data.description}
  noindex={!published}
  ogType="article"
  schema={schema}
>
  <article class="pt-28 pb-16 md:pt-32">
    <div class="container-page">
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "Insights", href: "/insights" },
          { label: post.data.title },
        ]}
      />
      <header class="max-w-3xl">
        {!published && <p class="badge">Editorial review — not published</p>}
        <p class="eyebrow mt-6">{post.data.category}</p>
        <h1 class="page-title mt-4">{post.data.title}</h1>
        <p class="lede mt-5">{post.data.description}</p>
        <p class="mt-6 text-sm text-muted">
          {
            published && publishedAt && (
              <>
                <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
                <span aria-hidden="true"> · </span>
              </>
            )
          }
          <span>{minutes} min read</span>
          <span aria-hidden="true"> · </span>
          <span>{site.name}</span>
        </p>
      </header>
      {
        showContents && (
          <nav class="article-toc surface-card mt-8 max-w-3xl p-6" aria-label="On this page">
            <h2 class="font-display text-lg font-semibold">On this page</h2>
            <ol class="mt-4 grid gap-2">
              {
                contents.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))
              }
            </ol>
          </nav>
        )
      }
      <div class="prose mt-10 max-w-3xl">
        <Content />
      </div>
      <p class="mt-10">
        <a href="/insights" class="text-lavender underline">Back to Insights</a>
      </p>
    </div>
  </article>
  {
    related.length > 0 && (
      <section class="section pt-0" aria-labelledby="related-heading">
        <div class="container-page">
          <h2 id="related-heading" class="font-display text-3xl font-semibold">Related notes</h2>
          <ul class="mt-6 grid gap-4 md:grid-cols-2">
            {
              related.map((entry) => (
                <li class="surface-card p-6">
                  <p class="text-sm text-muted">{entry.data.category}</p>
                  <h3 class="mt-3 font-display text-2xl font-semibold">
                    <a href={`/insights/${entry.id}`} class="hover:text-lavender">{entry.data.title}</a>
                  </h3>
                  <p class="mt-3 text-muted">{entry.data.description}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
