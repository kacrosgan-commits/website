---
import ProjectCard from "../../components/cards/ProjectCard.astro";
import CtaSection from "../../components/sections/CtaSection.astro";
import PageHero from "../../components/ui/PageHero.astro";
import { assets } from "../../data/assets";
import { services } from "../../data/services";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { filtersInUse, isVisibleProject } from "../../utils/portfolio";
import { getCollection } from "astro:content";

const dev = import.meta.env.DEV;
const projects = (await getCollection("caseStudies"))
  .filter((project) => isVisibleProject(project.data, dev))
  .sort((a, b) => a.data.homeRank - b.data.homeRank || a.data.title.localeCompare(b.data.title));
const filters = filtersInUse(projects.map((project) => project.data));
const reviewing = projects.some((project) => project.data.review && !project.data.publicationApproved);
const classificationReady = projects.length > 0 && projects.every((project) => project.data.filters.length > 0);
const showFilters = classificationReady && filters.length > 0;
---

<BaseLayout
  title="Selected Work"
  description={
    reviewing
      ? `Internal review of public products for ${site.name}. These pages are not approved client work.`
      : `Approved client work from ${site.name}. Case studies are published only after contribution and permission are confirmed.`
  }
  noindex={reviewing}
>
  <PageHero
    eyebrow="Portfolio"
    description={
      projects.length > 0
        ? "Digital Products Across Industries."
        : "Case studies appear here after the work and the right to publish it are confirmed. Until then, the services below describe what the studio takes on."
    }
    scene={assets.backgrounds.portfolioPortal}
    crumbs={[{ label: "Home", href: "/" }, { label: "Selected Work" }]}
  >
    Selected Work
  </PageHero>

  <section class="section pt-0" aria-labelledby="projects-heading">
    <div class="container-page">
      <h2 id="projects-heading" class="sr-only">Projects</h2>
      {
        reviewing && (
          <div class="surface-card mb-8 p-6 md:p-8">
            <p class="badge">Internal review</p>
            <p class="mt-4 max-w-3xl text-lg text-paper/90">
              Unapproved products on this page are open for local inspection. They are omitted from the production build and the sitemap. Approved work is published with them only in development.
            </p>
          </div>
        )
      }
      {
        projects.length === 0 && (
          <div>
            <div class="surface-card p-8">
              <p class="max-w-2xl text-lg text-paper/90">No client case studies are approved for publication.</p>
              <p class="mt-3 max-w-2xl text-muted">
                A published study will name the product, the confirmed role, and only outcomes that have been cleared. Until then, the services below describe the kind of work the studio takes on. They are not a record of these products.
              </p>
            </div>
            <ul class="mt-8 grid gap-4 md:grid-cols-2">
              {services.map((service) => (
                <li class="surface-card p-6">
                  <h3 class="font-display text-2xl font-semibold">
                    <a class="hover:text-lavender" href={`/services/${service.slug}`}>
                      {service.title}
                    </a>
                  </h3>
                  <p class="mt-3 text-muted">{service.summary}</p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        showFilters && (
          <div class="flex flex-wrap gap-2" data-filters>
            <button type="button" class="filter-btn" data-filter="all" aria-pressed="true">
              All
            </button>
            {filters.map((filter) => (
              <button type="button" class="filter-btn" data-filter={filter} aria-pressed="false">
                {filter}
              </button>
            ))}
          </div>
        )
      }
      <div class:list={["portfolio-grid mt-8", projects.length === 2 && "portfolio-grid-pair", projects.length === 4 && "portfolio-grid-quad", projects.length === 5 && "card-grid-five"]} data-project-grid>
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
      <p class="mt-8 text-muted" data-filter-empty hidden>
        No projects in this category.
      </p>
    </div>
  </section>
  <CtaSection
    title="Have a Similar Product in Mind?"
    description="Tell us what you want to build. Publishing a case study is a separate decision."
    href="/contact"
    label="Discuss Your Project"
  />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-project-grid] [data-filters]");
  const empty = document.querySelector<HTMLElement>("[data-filter-empty]");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter ?? "all";
      buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      let visible = 0;
      cards.forEach((card) => {
        const tags = (card.dataset.filters ?? "").split("|").filter(Boolean);
        const show = filter === "all" || tags.includes(filter);
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (empty) empty.hidden = visible !== 0;
    });
  });
</script>
