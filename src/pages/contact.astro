---
import ContactForm from "../components/forms/ContactForm.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import HeroTitle from "../components/ui/HeroTitle.astro";
import SocialLinks from "../components/ui/SocialLinks.astro";
import OutlineButton from "../components/ui/OutlineButton.astro";
import { activeSocialLinks, site } from "../data/site";
import { isConfiguredEndpoint } from "../utils/inquiry";
import BaseLayout from "../layouts/BaseLayout.astro";

const configured = isConfiguredEndpoint(site.formEndpoint);
---

<BaseLayout
  title="Contact"
  description={`Prepare a project inquiry for ${site.name}. The contact form does not send a message until delivery is configured.`}
>
  <section class="contact-page" data-hero>
    <div class="container-page">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Contact" }]} visible={false} />
      <div class="contact-layout">
        <div class="contact-head">
          <p class="eyebrow hero-in">Contact</p>
          <HeroTitle text="Tell Us About Your Project" />
          <p class="lede hero-in hero-in-3">
            Tell us about your product, the kind of work you need, and where the project stands. Budget and timeline can wait.
          </p>
        </div>
        <div class="contact-form min-w-0">
          <ContactForm />
        </div>
        <div class="contact-notes min-w-0">
          {
            !site.emailIsPlaceholder && (
              <section class="contact-note" aria-labelledby="contact-email-heading">
                <h2 id="contact-email-heading">Email</h2>
                <a class="contact-email" href={`mailto:${site.email}`}>
                  {site.email}
                </a>
              </section>
            )
          }
          <section class="contact-note" aria-labelledby="next-heading">
            <h2 id="next-heading">What happens next</h2>
            <ol class="next-steps">
              <li>We read your inquiry and reply to the email address you give.</li>
              <li>We start with a conversation about the product, the users, and what the first release has to do.</li>
              <li>If there is a fit, discovery and a written proposal follow. Scope, timing, and commercial terms are agreed there.</li>
            </ol>
          </section>
          {
            site.location && (
              <section class="contact-note" aria-labelledby="location-heading">
                <h2 id="location-heading">Location</h2>
                <p>{site.location}</p>
              </section>
            )
          }
          {
            activeSocialLinks.length > 0 && (
              <section class="contact-note" aria-labelledby="social-heading">
                <h2 id="social-heading">Social</h2>
                <SocialLinks class="mt-4" />
              </section>
            )
          }
          {
            site.bookingUrl && (
              <section class="contact-note" aria-labelledby="booking-heading">
                <h2 id="booking-heading">Book a conversation</h2>
                <p>Use the scheduling link if you already know you want a call.</p>
                <div class="mt-4">
                  <OutlineButton href={site.bookingUrl}>Open booking link</OutlineButton>
                </div>
              </section>
            )
          }
          <p class="contact-privacy">
            {
              configured
                ? "Your details go to our form provider so we can read and reply to your inquiry."
                : `With no delivery endpoint, the form does not submit your details to ${site.name}. Copying stays on this device.`
            }{" "}
            Read the <a href="/privacy">Privacy Policy</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
