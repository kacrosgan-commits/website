---
import ContactForm from "../components/forms/ContactForm.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import HeroTitle from "../components/ui/HeroTitle.astro";
import SocialLinks from "../components/ui/SocialLinks.astro";
import OutlineButton from "../components/ui/OutlineButton.astro";
import { activeSocialLinks, site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description={`Prepare a project inquiry for ${site.name}. The contact form does not send a message until delivery is configured.`}
>
  <section class="contact-page" data-hero>
    <div class="container-page">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Contact" }]} visible={false} />
      <div class="contact-layout">
        <div class="contact-head">
          <p class="eyebrow hero-in">Contact</p>
          <HeroTitle text="Tell Us About Your Project" />
          <p class="lede hero-in hero-in-3">
            Tell us about your product, the kind of work you need, and where the project stands. Budget and timeline can wait.
          </p>
        </div>
        <div class="contact-form min-w-0">
          <ContactForm />
        </div>
        <div class="contact-notes min-w-0">
          <article class="contact-note">
            <h2>What helps</h2>
            <p>
              Name the product, who it is for, and whether you need web, mobile, AI, SaaS, APIs, DevOps, design, or QA. Say what already exists. Budget and timeline are optional.
            </p>
          </article>
          <article class="contact-note">
            <h2>Email</h2>
            {
              site.emailIsPlaceholder ? (
                <p>A public inbox is not set. This page does not open a mail app or send the form.</p>
              ) : (
                <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
              )
            }
          </article>
          {
            site.location && (
              <article class="contact-note">
                <h2>Location</h2>
                <p>{site.location}</p>
              </article>
            )
          }
          {
            activeSocialLinks.length > 0 && (
              <article class="contact-note">
                <h2>Social</h2>
                <SocialLinks class="mt-4" />
              </article>
            )
          }
          {
            site.bookingUrl && (
              <article class="contact-note">
                <h2>Book a conversation</h2>
                <p>Use the scheduling link if you already know you want a call.</p>
                <div class="mt-4">
                  <OutlineButton href={site.bookingUrl}>Open booking link</OutlineButton>
                </div>
              </article>
            )
          }
          <article class="contact-note">
            <h2>Privacy</h2>
            <p>
              With no delivery endpoint, the form does not submit your details to {site.name}. Copying stays on this device. Read the <a href="/privacy">Privacy Policy</a> before you prepare an inquiry.
            </p>
            <p class="contact-note-links">
              <a href="/portfolio">Portfolio</a>
              <span aria-hidden="true"> · </span>
              <a href="/process">Process</a>
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
