---
import BlogCard from "../components/cards/BlogCard.astro";
import HomeProcessRibbon from "../components/home/HomeProcessRibbon.astro";
import HomeProductHero from "../components/home/HomeProductHero.astro";
import HomeServicesBento from "../components/home/HomeServicesBento.astro";
import HomeTechStrip from "../components/home/HomeTechStrip.astro";
import HomeWorkGrid from "../components/home/HomeWorkGrid.astro";
import TeamShowcase from "../components/sections/TeamShowcase.astro";
import CtaSection from "../components/sections/CtaSection.astro";
import FaqAccordion from "../components/sections/FaqAccordion.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import OutlineButton from "../components/ui/OutlineButton.astro";
import { faqs } from "../data/faq";
import { processSteps } from "../data/process";
import { featuredServices as localFeaturedServices } from "../data/services";
import { site } from "../data/site";
import { publicName } from "../data/team";
import BaseLayout from "../layouts/BaseLayout.astro";
import { homepageProjects } from "../utils/portfolio";
import { comparePublicInsights, isPublicInsight } from "../utils/insights";
import { getCollection } from "astro:content";
import {
  getHomepageForRender,
  getInsightsForRender,
  getProjectsForRender,
  getServicesForRender,
  getTeamForRender,
} from "../lib/content/site-content";
import { getContentSource } from "../lib/content/source";

const cms = getContentSource() === "cms";
const team = getTeamForRender();
const homepageCms = cms ? getHomepageForRender() : null;
const localProjects = cms ? [] : homepageProjects(await getCollection("caseStudies"));
const cmsProjects = cms
  ? getProjectsForRender()
      .slice()
      .sort((a, b) => a.homeRank - b.homeRank)
  : [];
const workLocal = localProjects;
const workCms = cmsProjects;
const projectCount = cms ? workCms.length : workLocal.length;

const preferredShowcase = ["scaleup-systems", "medastare", "gain-energy-upstrima"];

function pickLocalShowcase(projects: typeof workLocal) {
  const ranked = preferredShowcase
    .map((slug) => projects.find((project) => project.id === slug))
    .filter((project): project is NonNullable<typeof project> => Boolean(project))
    .concat(projects.filter((project) => !preferredShowcase.includes(project.id)));
  return ranked.flatMap((project) => {
    const shot = project.data.screenshots[0];
    if (!shot) return [];
    return [
      {
        slug: project.id,
        title: project.data.cardTitle || project.data.title,
        href: `/portfolio/${project.id}`,
        summary: project.data.cardSummary || project.data.description,
        category: project.data.category,
        src: shot.src,
        alt: shot.alt,
        width: shot.width,
        height: shot.height,
        layout: (project.data.mediaLayout === "mobile" ? "mobile" : "web") as "web" | "mobile",
      },
    ];
  }).slice(0, 3);
}

function pickCmsShowcase(projects: typeof workCms) {
  const ranked = preferredShowcase
    .map((slug) => projects.find((project) => project.slug === slug))
    .filter((project): project is NonNullable<typeof project> => Boolean(project))
    .concat(projects.filter((project) => !preferredShowcase.includes(project.slug)));
  return ranked.flatMap((project) => {
    const shot = project.screenshots[0];
    if (!shot?.src) return [];
    return [
      {
        slug: project.slug,
        title: project.cardTitle || project.title,
        href: `/portfolio/${project.slug}/`,
        summary: project.cardSummary || project.description,
        category: project.category,
        src: shot.src,
        alt: shot.alt || project.title,
        width: shot.width || 1200,
        height: shot.height || 800,
        layout: (project.mediaLayout === "mobile" ? "mobile" : "web") as "web" | "mobile",
      },
    ];
  }).slice(0, 3);
}

const showcase = cms ? pickCmsShowcase(workCms) : pickLocalShowcase(workLocal);

const localPosts = cms
  ? []
  : (await getCollection("blog"))
      .filter((post) => isPublicInsight(post.data))
      .sort((a, b) => comparePublicInsights({ ...a.data, id: a.id }, { ...b.data, id: b.id }))
      .slice(0, 3);
const cmsPosts = cms ? getInsightsForRender().slice(0, 3) : [];
const heroEyebrow = homepageCms?.heroEyebrow || "Software engineering for startups";
const heroTitle = homepageCms?.heroTitle || "We Build Software That Moves Business Forward.";
const heroLede =
  homepageCms?.heroLede ||
  `${site.name} helps startups design, build, and improve digital products: web and mobile applications, AI-powered software, and SaaS platforms with a foundation the team can keep changing.`;
const primaryCta = homepageCms?.primaryCtaLabel || "Start Your Project";
const primaryHref = homepageCms?.primaryCtaHref || "/contact";
const secondaryCta = homepageCms?.secondaryCtaLabel || "View Our Work";
const secondaryHref = homepageCms?.secondaryCtaHref || "/portfolio";
const featuredServices = cms
  ? getServicesForRender()
      .filter((service) => service.featured)
      .slice(0, 8)
  : localFeaturedServices;

const proof = [
  projectCount > 0 ? { value: String(projectCount), label: projectCount === 1 ? "approved case study" : "approved case studies" } : null,
  featuredServices.length > 0
    ? { value: String(featuredServices.length), label: featuredServices.length === 1 ? "service specialty" : "service specialties" }
    : null,
  team.length > 0 ? { value: String(team.length), label: team.length === 1 ? "team profile" : "team profiles" } : null,
].filter((item): item is { value: string; label: string } => item !== null);
---

<BaseLayout
  title={`${site.name} — Software Development Agency`}
  description={site.description}
  fullTitle
  schema={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.url,
    description: site.description,
  }}
>
  <HomeProductHero
    eyebrow={heroEyebrow}
    title={heroTitle}
    lede={heroLede}
    primaryHref={primaryHref}
    primaryLabel={primaryCta}
    secondaryHref={secondaryHref}
    secondaryLabel={secondaryCta}
    showcase={showcase}
    proof={proof}
  />

  {
    cms ? (
      <HomeWorkGrid mode="cms" projects={workCms} />
    ) : (
      <HomeWorkGrid mode="local" projects={workLocal} />
    )
  }

  <HomeServicesBento services={featuredServices} />

  <HomeProcessRibbon steps={processSteps} />

  <TeamShowcase
    eyebrow={homepageCms?.teamFilmEyebrow}
    heading={homepageCms?.teamFilmHeading}
    description={homepageCms?.teamFilmDescription}
    disclosure={homepageCms?.teamFilmDisclosure}
  />

  <section class="section reveal home-team" aria-labelledby="team-heading">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading eyebrow="People" description="Nine named profiles, from leadership through engineering, design, delivery, and quality. Collaboration scenes on this page are illustrations.">
          <span id="team-heading">The People Behind the Code.</span>
        </SectionHeading>
        <OutlineButton href="/team">Meet the team</OutlineButton>
      </div>
      <ul class="role-strip stagger-children mt-10">
        {
          team.map((member) => (
            <li class="motion-item">
              <a class="interactive-lift" href={`/team/${member.slug}`}>
                <img
                  src={member.portrait.thumb}
                  alt=""
                  width="384"
                  height="384"
                  loading="lazy"
                  decoding="async"
                />
                <span>
                  <span class="block">{publicName(member) ?? member.role}</span>
                  {publicName(member) && <span class="block text-sm font-medium text-muted">{member.role}</span>}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <HomeTechStrip />

  {
    (cms ? cmsPosts.length > 0 : localPosts.length > 0) && (
      <section class="section reveal bg-ink-soft/40" aria-labelledby="insights-heading">
        <div class="container-page">
          <SectionHeading eyebrow="Insights" description="Approved notes on building software. Drafts stay off this page.">
            <span id="insights-heading">Notes from the engineering team.</span>
          </SectionHeading>
          {cms ? (
            <div class="stagger-children mt-12 grid gap-4 md:grid-cols-3">
              {cmsPosts.map((post) => (
                <article class="surface-card motion-item p-6">
                  <p class="text-sm text-muted">{post.category || "Insights"}</p>
                  <h3 class="mt-3 font-display text-2xl font-semibold">
                    <a class="hover:text-lavender" href={`/insights/${post.slug}/`}>
                      {post.title}
                    </a>
                  </h3>
                  <p class="mt-3 text-muted">{post.excerpt}</p>
                </article>
              ))}
            </div>
          ) : (
            <div class="stagger-children mt-12 grid gap-4 md:grid-cols-3">
              {localPosts.map((post) => (
                <BlogCard post={post} />
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  <section class="section reveal" aria-labelledby="faq-heading">
    <div class="container-page">
      <SectionHeading eyebrow="Questions">
        <span id="faq-heading">Before we begin.</span>
      </SectionHeading>
      <div class="mt-8">
        <FaqAccordion items={faqs} />
      </div>
    </div>
  </section>

  <CtaSection
    title="Have an Idea? Let's Build It."
    description="Tell us what you're working on. We'll help you explore the right technical approach for your next product."
    label="Discuss Your Project"
    secondaryHref="/services"
    secondaryLabel="View Our Services"
  />
</BaseLayout>
