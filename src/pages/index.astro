---
import ProjectCard from "../components/cards/ProjectCard.astro";
import TeamShowcase from "../components/sections/TeamShowcase.astro";
import CtaSection from "../components/sections/CtaSection.astro";
import FaqAccordion from "../components/sections/FaqAccordion.astro";
import ProcessTimeline from "../components/sections/ProcessTimeline.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Stats from "../components/sections/Stats.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import GradientButton from "../components/ui/GradientButton.astro";
import OutlineButton from "../components/ui/OutlineButton.astro";
import { homeIntro, reasons } from "../data/about";
import { faqs } from "../data/faq";
import { processSteps } from "../data/process";
import { featuredServices as localFeaturedServices } from "../data/services";
import { technologyGroups } from "../data/technologies";
import { site } from "../data/site";
import { publicName } from "../data/team";
import BaseLayout from "../layouts/BaseLayout.astro";
import { homepageProjects } from "../utils/portfolio";
import { getCollection } from "astro:content";
import Icon from "../components/ui/Icon.astro";
import { getContentSource } from "../lib/content/source";
import {
  getHomepageForRender,
  getProjectsForRender,
  getServicesForRender,
  getTeamForRender,
} from "../lib/content/site-content";

const cms = getContentSource() === "cms";
const team = getTeamForRender();
const homepageCms = cms ? getHomepageForRender() : null;
const localProjects = cms ? [] : homepageProjects(await getCollection("caseStudies"));
const cmsProjects = cms
  ? getProjectsForRender()
      .filter((project) => project.featured || (homepageCms?.featuredProjectSlugs || []).includes(project.slug))
      .sort((a, b) => a.homeRank - b.homeRank)
      .slice(0, 3)
  : [];
const projectCount = cms ? cmsProjects.length : localProjects.length;
const heroEyebrow = homepageCms?.heroEyebrow || "Software engineering for startups";
const heroTitle = homepageCms?.heroTitle || "We Build Software That Moves Business Forward.";
const heroLede =
  homepageCms?.heroLede ||
  `${site.name} helps startups design, build, and improve digital products: web and mobile applications, AI-powered software, and SaaS platforms with a foundation the team can keep changing.`;
const primaryCta = homepageCms?.primaryCtaLabel || "Start Your Project";
const primaryHref = homepageCms?.primaryCtaHref || "/contact";
const secondaryCta = homepageCms?.secondaryCtaLabel || "View Our Work";
const secondaryHref = homepageCms?.secondaryCtaHref || "/portfolio";
/* Two ticker rows from the same catalog: the first half of the groups, then the rest. */
const tickerSplit = Math.ceil(technologyGroups.length / 2);
const tickerRows = [technologyGroups.slice(0, tickerSplit), technologyGroups.slice(tickerSplit)];
const featuredServices = cms
  ? getServicesForRender()
      .filter((service) => service.featured)
      .slice(0, 8)
  : localFeaturedServices;
---

<BaseLayout
  title={`${site.name} — Software Development Agency`}
  description={site.description}
  fullTitle
  schema={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.url,
    description: site.description,
  }}
>
  <section class="photo-hero-bleed" aria-label="Introduction" data-hero>
    <div class="photo-hero">
      <picture>
        <source type="image/webp" srcset="/images/vortex-digital-hall.webp" />
        <img
          class="photo-hero-img"
          src="/images/vortex-digital-hall.png"
          alt="Vortex Digital company hall with reception desk, lounge, and branded signage"
          width="1813"
          height="868"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
    <svg class="hero-ring" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="50"></circle></svg>
    <script is:inline>
      // Start the opening ring exactly on the halo light in the photo, and wait for the photo so the first frame is never empty.
      // The photo's box can be wider than the hero (desktop crops the wall logo out), so measure the box itself.
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var hero = document.currentScript.parentElement;
        var img = hero.querySelector(".photo-hero-img");
        var w = img.offsetWidth;
        var h = img.offsetHeight;
        var scale = Math.max(w / 1813, h / 868);
        var position = getComputedStyle(img).objectPosition.split(" ");
        var x = img.offsetLeft + (w - 1813 * scale) * (parseFloat(position[0]) / 100) + 1537 * scale;
        var y = img.offsetTop + (h - 868 * scale) * (parseFloat(position[1]) / 100) + 245 * scale;
        hero.style.setProperty("--hx", x + "px");
        hero.style.setProperty("--hy", y + "px");
        // The photo settles around the halo too, so the ring and the light stay together.
        img.style.transformOrigin = x - img.offsetLeft + "px " + (y - img.offsetTop) + "px";
        if (img.complete) return;
        hero.setAttribute("data-iris", "wait");
        var go = function () {
          hero.removeAttribute("data-iris");
        };
        img.addEventListener("load", go, { once: true });
        img.addEventListener("error", go, { once: true });
        setTimeout(go, 1400);
      })();
    </script>
    <div class="container-page photo-hero-content">
      <div class="photo-hero-copy">
        <p class="eyebrow hero-in">{heroEyebrow}</p>
        <h1 class="photo-hero-title">
          {
            heroTitle.split(/\s+/).map((word, index) => (
              <>
                <span class="w"><span style={`--i:${index}`}>{word}</span></span>{" "}
              </>
            ))
          }
        </h1>
        <div class="photo-hero-foot">
          <p class="lede hero-in hero-in-3">{heroLede}</p>
          <div class="hero-actions hero-in hero-in-4">
            <GradientButton href={primaryHref}>{primaryCta}</GradientButton>
            <OutlineButton href={secondaryHref}>{secondaryCta}</OutlineButton>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="home-flow">
  <section class="section reveal lux-intro" aria-labelledby="intro-heading">
    <div class="container-page lux-intro-grid tone-follow">
      <p class="eyebrow">{homeIntro.eyebrow}</p>
      <h2 id="intro-heading" class="section-title lux-intro-title">{homeIntro.title}</h2>
      <div class="lux-intro-body">
        <p class="lux-lead" data-scrub-words>{homeIntro.lead} {homeIntro.body}</p>
        <p class="support">{homeIntro.support}</p>
        <a href="/about" class="lux-link">Learn About Us</a>
      </div>
    </div>
  </section>

  {
    projectCount > 0 ? (
      <section class="lux-work" aria-labelledby="work-heading" data-work>
        <div class="container-page reveal">
          <div class="section-head-row">
            <SectionHeading eyebrow="Selected work" description="Recent web and mobile products we helped build.">
              <span id="work-heading">Recent work.</span>
            </SectionHeading>
            <OutlineButton href="/portfolio">View our work</OutlineButton>
          </div>
        </div>
        {
          cms ? (
            <div class="container-page">
              <div class="stagger-children mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                {cmsProjects.map((project) => (
                  <article class="surface-card motion-item overflow-hidden p-6">
                    <p class="text-sm text-muted">{project.client}</p>
                    <h3 class="mt-2 font-display text-2xl">
                      <a class="hover:text-lavender" href={`/portfolio/${project.slug}/`}>
                        {project.cardTitle || project.title}
                      </a>
                    </h3>
                    <p class="mt-3 text-muted">{project.cardSummary || project.description}</p>
                  </article>
                ))}
              </div>
            </div>
          ) : (
            <div class="work-rail" data-work-rail>
              <div class="work-pin">
                <div class="container-page work-viewport">
                  <div class="work-gallery" data-work-track data-liquid>
                    {localProjects.map((project) => <ProjectCard project={project} morph />)}
                  </div>
                </div>
                <div class="container-page work-progress" aria-hidden="true">
                  <span class="work-progress-bar"></span>
                </div>
              </div>
            </div>
          )
        }
      </section>
    ) : (
      <section class="lux-work" aria-labelledby="work-heading">
        <div class="container-page">
          <h2 id="work-heading" class="sr-only">Recent work</h2>
          <p class="max-w-2xl text-lg">No client engagements are approved for public display yet.</p>
          <p class="work-empty-note mt-3 max-w-2xl">
            The <a class="underline" href="/process">process</a> page describes how the work runs. It is not a record of past results.
          </p>
        </div>
      </section>
    )
  }

  <Testimonials />

  <TeamShowcase
    eyebrow={homepageCms?.teamFilmEyebrow}
    heading={homepageCms?.teamFilmHeading}
    description={homepageCms?.teamFilmDescription}
    disclosure={homepageCms?.teamFilmDisclosure}
  />

  <section class="section reveal lux-specialties" aria-labelledby="services-heading">
    <div class="container-page lux-split">
      <div class="lux-split-head">
        <SectionHeading eyebrow="Specialties" description="Web development, mobile apps, AI, SaaS, backend and APIs, cloud and DevOps, UI/UX, and QA.">
          <span id="services-heading">Eight specialties for a startup product.</span>
        </SectionHeading>
      </div>
      <ul class="spec-list" data-current-rows>
        {
          featuredServices.map((service) => (
            <li class="spec-row">
              <Icon name={service.icon} size={22} class="spec-icon" />
              <h3 class="spec-title">{service.title}</h3>
              <p class="spec-text">{service.summary}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section reveal lux-reasons" aria-labelledby="reasons-heading">
    <div class="container-page">
      <SectionHeading eyebrow="Our approach" description="What you can expect when we work together.">
        <span id="reasons-heading">How the work is run.</span>
      </SectionHeading>
      <ul class="reason-grid" data-spotlight>
        {
          reasons.map((reason) => (
            <li class="reason-bay">
              <Icon name={reason.icon} size={26} class="reason-icon" />
              <h3 class="reason-title">{reason.title}</h3>
              <p class="reason-text">{reason.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Stats />

  <section class="section reveal lux-stack" aria-labelledby="stack-heading">
    <div class="container-page">
      <div class="section-head-row">
        <SectionHeading eyebrow="Stack" description="The tools we use to build and ship.">
          <span id="stack-heading">Technology That Fits Your Product.</span>
        </SectionHeading>
        <button type="button" class="ticker-toggle" data-ticker-toggle aria-pressed="false" hidden>Pause motion</button>
      </div>
      <!-- Moving rows, armed by luxe-motion.ts. Decorative: the list below carries the same content. -->
      <div class="stack-ticker" aria-hidden="true" data-ticker>
        {
          tickerRows.map((groups, row) => (
            <div class:list={["ticker-row", row === 1 && "ticker-row-reverse"]}>
              <div class="ticker-track">
                {[0, 1, 2, 3].map(() =>
                  groups.map((group) => (
                    <span class="ticker-group">
                      <span class="ticker-cat">{group.label}</span>
                      {group.items.map((item) => (
                        <span class="ticker-item">{item}</span>
                      ))}
                    </span>
                  )),
                )}
              </div>
            </div>
          ))
        }
      </div>
      <dl class="stack-sheet">
        {
          technologyGroups.map((group) => (
            <div>
              <dt>{group.label}</dt>
              <dd>
                <ul>
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section reveal lux-process" aria-labelledby="process-heading">
    <div class="container-page">
      <div class="section-head-row">
        <SectionHeading eyebrow="Process" description="Six stages, from first conversation to launch and support.">
          <span id="process-heading">From Concept to Launch.</span>
        </SectionHeading>
        <a href="/process" class="lux-link">See the full process</a>
      </div>
      <div class="mt-[clamp(1.75rem,3.5vw,3rem)]">
        <ProcessTimeline steps={processSteps.map((step) => ({ ...step, homeTitle: step.title }))} compact />
      </div>
    </div>
  </section>

  <section class="section reveal lux-people" aria-labelledby="team-heading">
    <div class="container-page">
      <div class="section-head-row">
        <SectionHeading eyebrow="People" description="Leadership, engineering, design, delivery, and quality.">
          <span id="team-heading">The People Behind the Code.</span>
        </SectionHeading>
        <OutlineButton href="/team">Meet the team</OutlineButton>
      </div>
      <div class="people-wall" data-people>
        <div class="people-stage" aria-hidden="true">
          <svg class="people-ring" viewBox="0 0 100 100"><circle cx="50" cy="50" r="49.8" pathLength="1"></circle></svg>
          {
            team.map((member, index) => (
              <img
                class:list={["people-portrait", index === 0 && "is-active"]}
                src={member.portrait.src}
                alt=""
                width={member.portrait.width}
                height={member.portrait.height}
                loading="lazy"
                decoding="async"
              />
            ))
          }
        </div>
        <ul class="people-list">
          {
            team.map((member, index) => (
              <li>
                <a class:list={["people-row", index === 0 && "is-active"]} href={`/team/${member.slug}`} data-person>
                  <img class="people-thumb" src={member.portrait.thumb} alt="" width="384" height="384" loading="lazy" decoding="async" />
                  <span class="people-name">{publicName(member) ?? member.role}</span>
                  {publicName(member) && <span class="people-role">{member.role}</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section reveal lux-faq" aria-labelledby="faq-heading">
    <div class="container-page lux-split">
      <div class="lux-split-head">
        <SectionHeading eyebrow="Questions">
          <span id="faq-heading">Before we begin.</span>
        </SectionHeading>
      </div>
      <div class="lux-split-main">
        <FaqAccordion items={faqs} />
      </div>
    </div>
  </section>

  <CtaSection
    title="Have an Idea? Let's Build It."
    description="Tell us what you're working on. We'll help you explore the right technical approach for your next product."
    label="Discuss Your Project"
    secondaryHref="/process"
    secondaryLabel="See Our Process"
    ring={false}
  />
  </div>

  <script>
    // The WebGL scene is an enhancement. It loads only once the page is visible, loaded and idle,
    // and only where it can run smoothly. Everyone else keeps the static design.
    import { canMountVortex, hasHardwareWebgl } from "../scripts/vortex-gate.ts";

    const mount = () => {
      if (!hasHardwareWebgl()) return;
      import("../scripts/vortex-scene.ts")
        .then((scene) => scene.mountVortexScene())
        .catch(() => {});
    };
    const whenIdle = () => {
      if (document.visibilityState !== "visible") {
        document.addEventListener("visibilitychange", whenIdle, { once: true });
        return;
      }
      if ("requestIdleCallback" in window) window.requestIdleCallback(mount, { timeout: 2500 });
      else setTimeout(mount, 400);
    };
    if (canMountVortex()) {
      if (document.readyState === "complete") whenIdle();
      else window.addEventListener("load", whenIdle, { once: true });
    }
    window.addEventListener("pageshow", (event) => {
      if (event.persisted && canMountVortex()) whenIdle();
    });
  </script>
</BaseLayout>
