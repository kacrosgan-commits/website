# Copy to .env for local development.
# Variables prefixed with PUBLIC_ are exposed to the browser.
# Do not put private API keys here.

# Canonical site origin. Use https://example.com until the real domain is connected.
PUBLIC_SITE_URL=https://example.com

# Public inbox. hello@example.com is not shown as a live address.
# Setup steps: docs/contact-delivery.md
PUBLIC_CONTACT_EMAIL=hello@example.com

# Formspree form endpoint, for example https://formspree.io/f/xxxxxxxx
# Leave empty until the form is created. The site will not pretend a message was sent.
# CONTACT FORM NOT LIVE — GO-LIVE BLOCKER while this value is empty.
PUBLIC_FORMSPREE_ENDPOINT=

# Optional scheduling link. Leave empty to hide the booking button.
PUBLIC_BOOKING_URL=

# Step 10C — content source selector (server/build only).
# local (default) | cms-shadow | cms
# Missing/empty means local. Unknown values fail the build.
CONTENT_SOURCE=local

# Local Directus URL for Ubuntu builds. Never use PUBLIC_ prefix.
DIRECTUS_URL=http://127.0.0.1:8055

# Scoped read-only tokens from `npm run cms:setup-identities` (gitignored .env).
# Never commit real values. Never reuse ADMIN_TOKEN here.
# DIRECTUS_SHADOW_TOKEN=
# DIRECTUS_BUILD_TOKEN=
