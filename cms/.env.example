# Copy to cms/.env and replace every REPLACE_* value before starting.
# Never commit cms/.env. Generate strong random values locally, for example:
#   openssl rand -hex 32

PUBLIC_URL=http://127.0.0.1:8055

# Directus app secret (required). Use a long random hex/base64 string.
SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# PostgreSQL credentials used only on the internal Compose network.
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# First-boot Studio owner. Change after first login if desired.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Optional static admin token for local schema scripts only.
# Keep this out of Astro PUBLIC_* variables and out of the browser.
ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_ADMIN_TOKEN
